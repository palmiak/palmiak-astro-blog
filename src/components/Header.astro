---
import Logo from './Logo.astro';
import { u } from '../utils/url';

interface Props {
  isPost?: boolean;
}
const { isPost = false } = Astro.props;
---
<header class="site-header">
  <div class="header-inner">
    <a href={u('/')} class="logo-link" aria-label="Return to the homepage">
      <Logo />
    </a>

    <nav class="nav-r">
      <a class="na" href={u('/blog')}>Blog</a>
      <a class="na" href={u('/#speaking')}>Speaking</a>
      <a class="na" href="https://newsletter.maciekpalmowski.dev/" target="_blank" rel="noopener">Newsletter</a>
      <a class="nav-cta" href={u('/contact-me')}>Contact →</a>
    </nav>

    <!-- Mobile hamburger toggle -->
    <button
      id="mobile-menu-btn"
      class="mobile-btn"
      aria-label="Open navigation menu"
      aria-expanded="false"
    >
      <svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" aria-hidden="true">
        <line x1="11" y1="9" x2="11" y2="11"/>
        <line x1="21" y1="9" x2="21" y2="11"/>
        <line x1="16" y1="8" x2="16" y2="10"/>
        <path d="M27.8,14C26.9,8.3,21.9,4,16,4S5.1,8.3,4.2,14H27.8z"/>
        <path d="M4,16l1.5,1c0.9,0.6,2.1,0.6,3,0l0,0c0.9-0.6,2.1-0.6,3,0l0,0c0.9,0.6,2.1,0.6,3,0l0,0c0.9-0.6,2.1-0.6,3,0l0,0c0.9,0.6,2.1,0.6,3,0l0,0c0.9-0.6,2.1-0.6,3,0l0,0c0.9,0.6,2.1,0.6,3,0l1.5-1"/>
        <path d="M27,24H5c-1.1,0-2-0.9-2-2v0c0-1.1,0.9-2,2-2h22c1.1,0,2,0.9,2,2v0C29,23.1,28.1,24,27,24z"/>
        <path d="M27,24v1.4c0,1.5-1.2,2.6-2.6,2.6H7.6C6.2,28,5,26.8,5,25.4V24"/>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="mobile-menu hidden">
    <a class="mobile-na" href={u('/blog')}>Blog</a>
    <a class="mobile-na" href={u('/#speaking')}>Speaking</a>
    <a class="mobile-na" href="https://newsletter.maciekpalmowski.dev/" target="_blank" rel="noopener">Newsletter</a>
    <a class="mobile-na" href={u('/contact-me')}>Contact</a>
  </div>

  {isPost && <div id="progress" role="progressbar" aria-label="progress"></div>}
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(11,11,14,0.95);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--bd);
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  height: 54px;
}
.logo-link {
  text-decoration: none;
  flex-shrink: 0;
}
.nav-r {
  display: flex;
  align-items: center;
  gap: 28px;
}
.na {
  font-size: 13px;
  color: var(--mid);
  cursor: pointer;
  text-decoration: none;
  transition: color 0.15s;
  position: relative;
}
.na::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 1px;
  background: linear-gradient(90deg, #ff2d78, #a855f7);
  transition: width 0.2s ease;
}
.na:hover {
  color: var(--hi);
}
.na:hover::after {
  width: 100%;
}
.nav-cta {
  font-size: 10px;
  font-family: 'IBM Plex Mono', monospace;
  letter-spacing: 0.06em;
  padding: 7px 15px;
  border-radius: 4px;
  cursor: pointer;
  border: 1px solid rgba(168,85,247,0.45);
  color: #c084fc;
  background: rgba(168,85,247,0.07);
  text-decoration: none;
  transition: border-color 0.15s, background 0.15s, transform 0.15s;
}
.nav-cta:hover {
  border-color: rgba(168,85,247,0.7);
  background: rgba(168,85,247,0.12);
  transform: translateY(-1px);
}
.mobile-btn {
  display: none;
  background: rgba(35, 31, 82, 0.6);
  border: none;
  color: white;
  border-radius: 9999px;
  padding: 10px;
  cursor: pointer;
  line-height: 0;
}
.mobile-btn svg {
  width: 24px;
  height: 24px;
}
.mobile-menu {
  border-top: 1px solid var(--bd);
  padding: 12px 24px 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.mobile-menu.hidden {
  display: none;
}
.mobile-na {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.08em;
  color: var(--mid);
  text-decoration: none;
  padding: 10px 0;
  border-bottom: 1px solid var(--bd);
  transition: color 0.15s;
}
.mobile-na:hover {
  color: var(--hi);
}
.mobile-na:last-child {
  border-bottom: none;
}

@media (max-width: 640px) {
  .nav-r {
    display: none;
  }
  .mobile-btn {
    display: flex;
    align-items: center;
    justify-content: center;
  }
}
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('click', (e) => {
    if (btn && menu && !btn.contains(e.target as Node) && !menu.contains(e.target as Node)) {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });
</script>
