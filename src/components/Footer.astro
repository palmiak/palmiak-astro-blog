---
import { u } from '../utils/url';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="foot-inner col">
    <div class="foot-l">© {year} Maciek Palmowski · Łódź, Poland</div>
    <div class="foot-links">
      <a class="foot-a" href={u('/blog')}>Blog</a>
      <a class="foot-a" href={u('/#speaking')}>Speaking</a>
      <a class="foot-a" href="https://newsletter.maciekpalmowski.dev/" target="_blank" rel="noopener">Newsletter</a>
    </div>
  </div>
</footer>

<style>
.site-footer {
  padding: 22px 0;
}
.col {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 24px;
}
.foot-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.foot-l {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  color: var(--dim);
  letter-spacing: 0.08em;
}
.foot-links {
  display: flex;
  gap: 20px;
}
.foot-a {
  font-size: 12px;
  color: var(--dim);
  cursor: pointer;
  transition: color 0.15s;
  font-family: 'IBM Plex Mono', monospace;
  letter-spacing: 0.04em;
  text-decoration: none;
}
.foot-a:hover {
  color: var(--mid);
}
</style>
