---
import { u } from '../utils/url';
const year = new Date().getFullYear();

const socials = [
  { label: 'Bluesky', href: 'https://bsky.app/profile/maciekpalmowski.dev' },
  { label: 'X', href: 'https://twitter.com/palmiak_fp' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/maciekpalmowski/' },
  { label: 'GitHub', href: 'https://github.com/palmiak' },
];
---
<footer class="site-footer">
  <div class="wrap">
    <a class="signoff" href={u('/contact-me')}>
      <span class="signoff-title t-display-xl">Say hello<span class="hush-title-dot">.</span></span>
      <span class="signoff-sub">Talks, questions, ideas for a post. Write to me.</span>
    </a>

    <div class="foot-bar">
      <div class="foot-l">© {year} Maciek Palmowski, Łódź, Poland</div>
      <nav class="foot-links" aria-label="Footer">
        <a href={u('/blog')}>Blog</a>
        <a href={u('/speaking')}>Speaking</a>
        <a href="https://newsletter.maciekpalmowski.dev/" target="_blank" rel="noopener">Newsletter</a>
        {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </nav>
    </div>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid var(--border-subtle);
  padding-top: clamp(64px, 12vw, 144px);
  overflow: clip;
}
.signoff {
  display: block;
  text-decoration: none;
  padding-bottom: clamp(48px, 8vw, 96px);
  border-radius: var(--radius-lg);
}
.signoff-title { display: block; }
.signoff-sub {
  display: block;
  margin-top: var(--space-6);
  font-size: 15px;
  line-height: 24px;
  color: var(--ink-muted);
  transition: color var(--dur-hover) var(--ease-in);
}
.signoff:hover .signoff-sub { color: var(--ink); }
.foot-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px 24px;
  padding-block: 20px;
  border-top: 1px solid var(--border-subtle);
}
.foot-l { font-size: 12px; line-height: 16px; color: var(--ink-subtle); }
.foot-links { display: flex; flex-wrap: wrap; gap: 4px 20px; }
.foot-links a {
  font-size: 12px;
  line-height: 16px;
  color: var(--ink-muted);
  text-decoration: none;
  transition: color var(--dur-hover) var(--ease-in);
}
.foot-links a:hover { color: var(--accent-hover); }
</style>
