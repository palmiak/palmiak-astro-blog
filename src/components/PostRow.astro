---
import Tag from './Tag.astro';
import { u } from '../utils/url';

interface Props {
  title: string;
  slug: string;
  tags?: string[];
  excerpt?: string;
  pubDate: Date;
}

const { title, slug, tags = [], excerpt, pubDate } = Astro.props;

const dateStr = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---
<a class="post-row" href={u(`/blog/${slug}`)} data-rule>
  <div class="post-row-inner" data-reveal>
    <div class="post-meta">
      <time class="post-date" datetime={pubDate.toISOString()}>{dateStr}</time>
      {tags.slice(0, 1).map((tag) => <Tag tag={tag} />)}
    </div>
    <div class="post-body">
      <h3 class="post-row-title t-title-2">{title}</h3>
      {excerpt && <p class="post-row-excerpt">{excerpt}</p>}
    </div>
    <svg class="post-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14" />
      <path d="m13 6 6 6-6 6" />
    </svg>
  </div>
</a>

<style>
.post-row {
  display: block;
  border-top: 1px solid var(--border);
  text-decoration: none;
  color: inherit;
  margin-inline: calc(var(--space-6) * -1);
  border-radius: 0;
  transition: background-color var(--dur-hover) var(--ease-in);
}
.post-row:last-child { border-bottom: 1px solid var(--border); }
.post-row:hover { background: var(--surface-100); }

.post-row-inner {
  display: grid;
  grid-template-columns: 148px minmax(0, 1fr) 24px;
  gap: var(--space-6);
  align-items: start;
  padding: var(--space-8) var(--space-6);
}
.post-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
  padding-top: 6px;
}
.post-date {
  font-family: var(--font-mono);
  font-size: 12px;
  line-height: 16px;
  color: var(--ink-subtle);
}
.post-row-title { transition: transform var(--dur-fade) var(--ease-in); }
.post-row:hover .post-row-title { transform: translateX(4px); }
.post-row-excerpt {
  margin-top: var(--space-3);
  max-width: 62ch;
  font-size: 14px;
  line-height: 22px;
  color: var(--ink-muted);
}
.post-arrow {
  width: 20px;
  height: 20px;
  margin-top: 8px;
  color: var(--ink-subtle);
  opacity: 0;
  transform: translateX(-6px);
  transition: opacity var(--dur-fade) var(--ease-in), transform var(--dur-fade) var(--ease-in), color var(--dur-fade) var(--ease-in);
}
.post-row:hover .post-arrow,
.post-row:focus-visible .post-arrow { opacity: 1; transform: none; color: var(--accent); }

@media (max-width: 720px) {
  .post-row { margin-inline: calc(var(--gutter) * -1); }
  .post-row-inner {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-6) var(--gutter);
  }
  .post-meta { flex-direction: row; align-items: center; gap: var(--space-3); padding-top: 0; }
  .post-arrow { display: none; }
}
</style>
