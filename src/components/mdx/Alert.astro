<aside class="alert-box" role="note">
  <svg class="alert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
    <path d="M9 18h6" />
    <path d="M10 22h4" />
  </svg>
  <div class="alert-content">
    <slot />
  </div>
</aside>

<style>
.alert-box {
  display: flex;
  gap: var(--space-4);
  padding: var(--space-4);
  background: var(--surface-200);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  align-items: flex-start;
  margin: var(--space-6) 0;
}
.alert-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  margin-top: 2px;
  color: var(--ink-muted);
}
.alert-content {
  color: var(--ink-muted);
  font-size: 15px;
  line-height: 1.7;
}
.alert-content :global(p) { margin: 0; }
.alert-content :global(p + p) { margin-top: 0.75rem; }
</style>
