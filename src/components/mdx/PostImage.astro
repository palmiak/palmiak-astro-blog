---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt?: string;
  width?: string;
  caption?: string;
}

const { src, alt = '', width = '', caption } = Astro.props;

// Strip /assets/ prefix to look up from src/assets/
const assetPath = src.startsWith('/assets/') ? src.slice('/assets/'.length) : src;
const isGif = assetPath.endsWith('.gif');

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/arts/**/*.{jpg,jpeg,png,webp,svg}'
);

const lookupKey = `/src/assets/${assetPath}`;
const imgMetadata = !isGif && images[lookupKey]
  ? (await images[lookupKey]()).default
  : null;

const imgWidths = width === 'wide'
  ? [800, 1110]
  : width === 'narrow'
  ? [320, 620]
  : [430, 860];

const imgClass = width === 'narrow'
  ? 'mx-auto max-w-[620px] w-full'
  : width === 'wide'
  ? ''
  : 'max-w-[860px] w-full';
---
<figure class={`post-figure image ${width}`}>
  {imgMetadata ? (
    <Image
      src={imgMetadata}
      alt={alt}
      loading="lazy"
      widths={imgWidths}
      sizes={
        width === 'wide'
          ? '(max-width: 800px) 800px, 1110px'
          : width === 'narrow'
          ? '(max-width: 320px) 320px, 620px'
          : '(max-width: 430px) 430px, 860px'
      }
      class={imgClass}
    />
  ) : (
    <img src={src} alt={alt} loading="lazy" class={imgClass} />
  )}
  {caption && (
    <figcaption class="post-figcaption">{caption}</figcaption>
  )}
</figure>

<style>
.post-figure {
  margin: 36px 0;
}
.post-figure img {
  width: 100%;
  border-radius: 6px;
  display: block;
  border: 1px solid var(--bd);
}
.post-figcaption {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.08em;
  color: var(--dim);
  text-align: center;
  margin-top: 10px;
}
</style>
