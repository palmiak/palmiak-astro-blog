---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt?: string;
  width?: string;
  caption?: string;
}

const { src, alt: altProp, width = '', caption } = Astro.props;
// Always describe the image: the alt text, else the caption
const alt = altProp ?? caption ?? '';

// Strip /assets/ prefix to look up from src/assets/
const assetPath = src.startsWith('/assets/') ? src.slice('/assets/'.length) : src;
const isGif = assetPath.endsWith('.gif');

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,svg}'
);
// Animated GIFs are served as-is (the image service would flatten them), but still fingerprinted by the build
const gifs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.gif');

const lookupKey = `/src/assets/${assetPath}`;
const imgMetadata = !isGif && images[lookupKey]
  ? (await images[lookupKey]()).default
  : null;
const gifMetadata = isGif && gifs[lookupKey] ? (await gifs[lookupKey]()).default : null;

const imgWidths = width === 'wide'
  ? [800, 1110]
  : width === 'narrow'
  ? [320, 620]
  : [430, 860];

const imgClass = width === 'narrow'
  ? 'mx-auto max-w-[620px] w-full'
  : width === 'wide'
  ? ''
  : 'max-w-[860px] w-full';
---
<figure class={`post-figure image ${width}`}>
  {imgMetadata ? (
    <Image
      src={imgMetadata}
      alt={alt}
      loading="lazy"
      widths={imgWidths}
      sizes={
        width === 'wide'
          ? '(max-width: 800px) 800px, 1110px'
          : width === 'narrow'
          ? '(max-width: 320px) 320px, 620px'
          : '(max-width: 430px) 430px, 860px'
      }
      class={imgClass}
    />
  ) : gifMetadata ? (
    <img src={gifMetadata.src} width={gifMetadata.width} height={gifMetadata.height} alt={alt} loading="lazy" class={imgClass} />
  ) : (
    <img src={src} alt={alt} loading="lazy" class={imgClass} />
  )}
  {caption && (
    <figcaption class="post-figcaption">{caption}</figcaption>
  )}
</figure>

<style>
.post-figure { margin: 2.25rem 0; }
.post-figure img {
  width: 100%;
  border-radius: var(--radius-lg);
  display: block;
  border: 1px solid var(--border);
}
.post-figcaption {
  font-size: 12px;
  line-height: 16px;
  color: var(--ink-subtle);
  text-align: center;
  margin-top: var(--space-3);
}
</style>
