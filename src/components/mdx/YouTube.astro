---
interface Props {
  url: string;
}

const { url } = Astro.props;
---
<div class="yt-wrap">
  <iframe
    src={`${url}?rel=0`}
    title="YouTube video player"
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>

<style>
.yt-wrap {
  width: 100%;
  aspect-ratio: 16 / 9;
}
.yt-wrap iframe {
  width: 100%;
  height: 100%;
}
</style>
