---
interface Props {
  tag: string;
}

const { tag } = Astro.props;

// Map tag names to color variants
const tagLower = tag.toLowerCase();
const isGreen = ['astro', 'wordcamp', 'jamstack', 'headless', 'cicd', 'ci/cd', 'development'].includes(tagLower);
const isPink = ['security', 'patchstack', 'wordpress security'].includes(tagLower);
// Default (violet) for conferences, wordpress, speaking, etc.

const cls = isGreen ? 'tag-green' : isPink ? 'tag-pink' : 'tag-violet';
---
<span class={`tag ${cls}`}>{tag}</span>

<style>
.tag {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 3px;
  display: inline-block;
  line-height: 1.4;
  transition: transform 0.15s ease, opacity 0.15s;
}
.tag:hover {
  transform: translateY(-1px);
  opacity: 0.85;
}
.tag-violet {
  color: #c084fc;
  border: 1px solid rgba(168, 85, 247, 0.3);
  background: rgba(168, 85, 247, 0.07);
}
.tag-pink {
  color: #f472b6;
  border: 1px solid rgba(255, 45, 120, 0.3);
  background: rgba(255, 45, 120, 0.07);
}
.tag-green {
  color: #4dffd6;
  border: 1px solid rgba(0, 255, 179, 0.3);
  background: rgba(0, 255, 179, 0.06);
}
</style>
