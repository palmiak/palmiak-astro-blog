---
interface Props {
  variant?: 'home' | 'post';
}
const { variant = 'home' } = Astro.props;
const href = 'https://newsletter.maciekpalmowski.dev/subscribe';
---

{variant === 'home' ? (
  <section class="nl-home section hairline">
    <div class="wrap nl-grid">
      <h2 class="t-title-1" data-reveal>Get new posts by email</h2>
      <div class="nl-side" data-reveal>
        <p class="nl-sub">Posts and links from the WordPress and web world, about once a week. No spam, and you can leave any time.</p>
        <a class="btn btn-accent" href={href}>Subscribe</a>
      </div>
    </div>
  </section>
) : (
  <div class="nl-post wrap wrap-narrow">
    <div class="nl-inner" data-reveal>
      <div>
        <h2 class="t-title-3">Enjoyed this post?</h2>
        <p class="nl-sub-sm">New posts straight to your inbox. No spam.</p>
      </div>
      <a class="btn btn-accent" href={href}>Subscribe</a>
    </div>
  </div>
)}

<style>
.nl-grid {
  display: grid;
  gap: var(--space-8);
  align-items: end;
}
.nl-side { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); }
.nl-sub { max-width: 44ch; font-size: 15px; line-height: 24px; color: var(--ink-muted); }
@media (min-width: 860px) {
  .nl-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: var(--space-12); }
}

.nl-post { padding-block: var(--space-12); }
.nl-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
  padding: var(--space-6);
  background: var(--surface-200);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
}
.nl-sub-sm { margin-top: 4px; font-size: 13px; line-height: 20px; color: var(--ink-muted); }
</style>
