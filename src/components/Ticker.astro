---
interface Props {
  items: string[];
}
const { items } = Astro.props;
// Repeat so a row always spans wider than the viewport
const row = [...items, ...items, ...items];
---
<div class="ticker" aria-hidden="true">
  <div class="ticker-row ticker-a">
    {row.map((name) => <span class="ticker-item">{name}<i class="ticker-sep"></i></span>)}
  </div>
  <div class="ticker-row ticker-b">
    {[...row].reverse().map((name) => <span class="ticker-item">{name}<i class="ticker-sep"></i></span>)}
  </div>
</div>

<style>
.ticker {
  overflow: clip;
  padding-block: clamp(40px, 7vw, 88px);
  border-top: 1px solid var(--border-subtle);
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
}
.ticker-row {
  display: flex;
  align-items: center;
  width: max-content;
  font-family: var(--font-title);
  font-weight: 300;
  font-size: clamp(40px, 7vw, 88px);
  line-height: 1.15;
  letter-spacing: -0.04em;
  white-space: nowrap;
}
.ticker-a { color: var(--ink); }
.ticker-b { color: var(--ink-subtle); margin-top: 0.1em; }
.ticker-item { display: inline-flex; align-items: center; }
.ticker-sep {
  display: inline-block;
  width: 0.14em;
  height: 0.14em;
  margin-inline: 0.6em;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.5;
}

/* Moves only while you scroll: opposite directions per row */
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .ticker-a, .ticker-b {
      animation: ticker-left linear both;
      animation-timeline: view();
      animation-range: cover 0% cover 100%;
    }
    .ticker-b { animation-name: ticker-right; }
  }
}
/* Travel is set in vw, not % of the row, so the pace stays the same however many events the row holds */
@keyframes ticker-left {
  from { transform: translateX(6vw); }
  to   { transform: translateX(-74vw); }
}
@keyframes ticker-right {
  from { transform: translateX(-74vw); }
  to   { transform: translateX(6vw); }
}
</style>
