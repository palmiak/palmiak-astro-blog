<style>
.hero {
  padding: 84px 0 76px;
  border-bottom: 1px solid var(--bd);
}
.col {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 24px;
}
.h-eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 30px;
}
.h-pip {
  display: flex;
  gap: 3px;
  align-items: center;
}
.h-pip span {
  display: block;
  border-radius: 99px;
}
.h-pip span:nth-child(1) { width: 18px; height: 3px; background: #ff2d78; }
.h-pip span:nth-child(2) { width: 10px; height: 3px; background: #a855f7; }
.h-pip span:nth-child(3) { width: 6px;  height: 3px; background: #00ffb3; }
.h-eyebrow-text {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--mid);
}
.h-name {
  font-family: 'Unbounded', sans-serif;
  font-size: 44px;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.05;
  margin-bottom: 2px;
  color: var(--hi);
}
.h-sub {
  font-family: 'Instrument Serif', serif;
  font-size: 46px;
  font-weight: 400;
  font-style: italic;
  letter-spacing: -0.01em;
  line-height: 1.1;
  margin-bottom: 36px;
}
.h-bio {
  font-size: 17px;
  line-height: 1.8;
  color: var(--mid);
  font-weight: 300;
  max-width: 560px;
  margin-bottom: 32px;
}
.h-bio strong {
  color: var(--hi);
  font-weight: 400;
}
.h-actions {
  display: flex;
  gap: 10px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}
.btn-p {
  font-size: 11px;
  font-weight: 400;
  padding: 10px 20px;
  border-radius: 4px;
  border: 1px solid rgba(0,255,179,0.4);
  color: #4dffd6;
  background: rgba(0,255,179,0.06);
  cursor: pointer;
  font-family: 'IBM Plex Mono', monospace;
  letter-spacing: 0.07em;
  transition: border-color 0.15s, background 0.15s;
  text-decoration: none;
}
.btn-p:hover { border-color: rgba(0,255,179,0.65); background: rgba(0,255,179,0.1); }
.btn-g {
  font-size: 11px;
  font-weight: 400;
  padding: 10px 20px;
  border-radius: 4px;
  border: 1px solid var(--bd2);
  color: var(--mid);
  background: transparent;
  cursor: pointer;
  font-family: 'IBM Plex Mono', monospace;
  letter-spacing: 0.07em;
  transition: color 0.15s, border-color 0.15s;
  text-decoration: none;
}
.btn-g:hover { color: var(--hi); border-color: rgba(255,255,255,0.25); }

.h-socials {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-top: 32px;
  border-top: 1px solid var(--bd);
  flex-wrap: wrap;
}
.soc {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.06em;
  padding: 9px 15px;
  border-radius: 4px;
  border: 1px solid var(--bd2);
  color: var(--mid);
  background: transparent;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
  text-decoration: none;
}
.soc svg { flex-shrink: 0; }
.soc:hover { color: var(--hi); border-color: rgba(255,255,255,0.25); background: var(--bg1); }
.soc.bsky:hover { color: #74b9ff; border-color: rgba(116,185,255,0.35); background: rgba(116,185,255,0.05); }
.soc.tw:hover   { color: #e8eaf0; border-color: rgba(255,255,255,0.3);  background: rgba(255,255,255,0.04); }
.soc.li:hover   { color: #60a5fa; border-color: rgba(96,165,250,0.35);  background: rgba(96,165,250,0.05); }
.soc.gh:hover   { color: #c084fc; border-color: rgba(192,132,252,0.35); background: rgba(192,132,252,0.05); }

@media (max-width: 640px) {
  .h-name { font-size: 30px; }
  .h-sub  { font-size: 30px; }
  .hero   { padding: 48px 0 52px; }
}
</style>
