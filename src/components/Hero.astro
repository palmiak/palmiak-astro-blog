const letters = (word: string) => [...word];
---
<section class="hero">
  <div class="wrap hero-inner">
    <h1 class="hero-title t-display-xl">
      <span class="hero-line"><span style="--i:0">{letters('Maciek').map((c) => <span class="ch">{c}</span>)}</span></span>
      <span class="hero-line"><span style="--i:1">{letters('Palmowski').map((c) => <span class="ch">{c}</span>)}<span class="hero-dot hush-title-dot">.</span></span></span>
    </h1>

    <div class="hero-after-wrap">
      <div class="hero-grid">
        <div class="hero-copy hero-after" style="--i:0">
          <p class="hero-role">Developer and speaker</p>
          <p class="hero-bio">
            Growth Engineer at <strong>Patchstack</strong>. 15+ years in web development,
            writing about WordPress security, headless CMS and Astro.
          </p>
        </div>

        <div class="hero-actions hero-after" style="--i:1">
          <a class="btn btn-primary" href={u('/blog')}>
            Read the blog
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
          </a>
          <a class="btn btn-secondary" href={u('/speaking')}>Speaking</a>
        </div>
      </div>

      <ul class="hero-socials hero-after" style="--i:2">
        {socials.map((s) => (
          <li>
            <a class="btn btn-ghost" href={s.href} target="_blank" rel="me noopener" aria-label={s.label}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Letters thicken (300 to 450) as the pointer gets close. Type only, no layout motion beyond the glyphs.
  const title = document.querySelector<HTMLElement>('.hero-title');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (title && canHover && !calm) {
    const chars = [...title.querySelectorAll<HTMLElement>('.ch')];
    const base = 300;
    const peak = 450;
    const radius = 220;
    const weights = chars.map(() => base);

    // Pin every letter to its resting width so a heavier glyph never pushes the letters (and the
    // pink dot) after it sideways. Glyphs grow in place, centred in their box.
    const lock = () => {
      chars.forEach((el, i) => {
        el.style.width = '';
        el.style.display = '';
        el.style.fontWeight = '';
        weights[i] = base;
      });
      const rects = chars.map((el) => el.getBoundingClientRect());
      chars.forEach((el, i) => {
        const next = rects[i + 1];
        const sameLine = next && Math.abs(next.top - rects[i].top) < rects[i].height / 2;
        const w = sameLine ? next.left - rects[i].left : rects[i].width;
        el.style.display = 'inline-block';
        el.style.width = `${w}px`;
        el.style.textAlign = 'center';
      });
    };
    document.fonts.ready.then(lock);
    let resizeTimer = 0;
    addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(lock, 120);
    });

    let px = -9999;
    let py = -9999;
    let raf = 0;

    const tick = () => {
      let moving = false;
      chars.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        const d = Math.hypot(px - (r.left + r.width / 2), py - (r.top + r.height / 2));
        const t = Math.max(0, 1 - d / radius);
        const target = base + (peak - base) * t * t * (3 - 2 * t);
        weights[i] += (target - weights[i]) * 0.14;
        if (Math.abs(target - weights[i]) > 0.4) moving = true;
        el.style.fontWeight = String(Math.round(weights[i]));
      });
      raf = moving ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

    addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' || title.getBoundingClientRect().bottom < 0) return;
      px = e.clientX;
      py = e.clientY;
      kick();
    });
    document.documentElement.addEventListener('pointerleave', () => { px = py = -9999; kick(); });
  }
</script>

<style>
.hero {
  min-height: calc(100svh - var(--frame) * 2 - var(--header-h));
  display: flex;
  align-items: flex-end;
  padding-block: clamp(48px, 8vw, 96px) clamp(32px, 5vw, 64px);
}
.hero-inner { display: flex; flex-direction: column; gap: clamp(40px, 7vw, 88px); }
.hero-title { will-change: transform; }
.hero-line {
  display: block;
  overflow: hidden;
  padding-block: 0.08em 0.14em;
  margin-block: -0.08em -0.14em;
}
.hero-dot { display: inline-block; }
.ch { font-weight: 300; }

.hero-after-wrap { display: flex; flex-direction: column; gap: var(--space-8); }
.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-6);
  align-items: end;
  padding-top: var(--space-8);
  border-top: 1px solid var(--border-subtle);
}
.hero-role {
  font-size: 13px;
  line-height: 16px;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: var(--space-3);
}
.hero-bio {
  max-width: 46ch;
  font-size: 16px;
  line-height: 26px;
  color: var(--ink-muted);
}
.hero-bio strong { color: var(--ink); font-weight: 500; }
.hero-actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }
.hero-socials { display: flex; flex-wrap: wrap; gap: 4px; list-style: none; margin-left: -12px; }

@media (min-width: 860px) {
  .hero-grid { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-12); }
}
</style>
