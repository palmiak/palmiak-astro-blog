---
import { u } from '../utils/url';
---
<section class="hero">
  <div class="col">
    <div class="h-eyebrow">
      <div class="h-pip">
        <span></span><span></span><span></span>
      </div>
      <span class="h-eyebrow-text">Developer · Speaker · Open Source</span>
    </div>

    <div class="h-name">Maciek Palmowski</div>
    <div class="h-sub grad-text">Developer &amp; Speaker</div>

    <p class="h-bio">
      mVDP Growth Manager at <strong>Patchstack</strong>. 15+ years in web development.
      Writing about WordPress security, headless CMS, and Astro.
    </p>

    <div class="h-actions">
      <a class="btn-p" href={u('/blog')}>Read the blog →</a>
      <a class="btn-g" href={u('/#speaking')}>View talks</a>
    </div>

    <div class="h-socials">
