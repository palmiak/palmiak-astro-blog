---
import { Picture } from 'astro:assets';
import herooImage from '../assets/heroop.png';
---
<section class="container mx-auto px-5 max-[660px]:px-0">
  <div class="relative min-[1024px]:pl-[500px] max-[1023px]:pb-[0px] max-[660px]:rounded-none max-[1023px]:bg-[length:auto_600px] rounded-2xl grid items-center bg-[#0F0E14] bg-left-bottom bg-no-repeat px-10 py-12 hero-shadow">
    <div class="relative z-20 flex-col justify-center items-start gap-7 flex max-w-[700px]">
      <h1 class="text-3xl md:text-6xl font-bold font-palmiak-font-title m-0">Maciek Palmowski</h1>
      <hr class="gradient-line" />
      <div class="prose-post">
        <p>I'm a web developer working at <strong>Patchstack</strong>, a public speaker, and an Open Source enthusiast.</p>
        <p>After hours, I spend most of my time trying to find interesting guests for the <strong>Code and Coffee Show</strong>, drinking coffee or cycling.</p>
      </div>
      <div class="justify-start items-center gap-5 inline-flex max-[660px]:flex max-[660px]:flex-col w-full max-[660px]:items-start min-[1000px]:flex min-[1000px]:flex-col min-[1250px]:inline-flex min-[1000px]:items-start min-[1250px]:flex-row">
        <div class="justify-start items-center gap-5 inline-flex">
          <a href="https://bsky.app/profile/maciekpalmowski.dev" target="about:blank" aria-label="Bluesky"
            class="rounded-full w-[62px] h-[62px] bg-palmiak_limedark flex relative transition-all duration-150 hover:bg-palmiak_lightdark hover:bg-opacity-40">
            <svg class="absolute inset-1/2 -translate-y-1/2 -translate-x-1/2 w-[30px] h-[30px]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z"/>
            </svg>
          </a>
          <a href="https://twitter.com/palmiak_fp" target="about:blank" aria-label="Twitter / X"
            class="rounded-full w-[62px] h-[62px] bg-palmiak_green flex relative transition-all duration-150 hover:bg-palmiak_lightdark hover:bg-opacity-40">
            <svg class="absolute inset-1/2 -translate-y-1/2 -translate-x-1/2 w-[30px] h-[30px]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/maciekpalmowski/" target="about:blank" aria-label="Linkedin"
            class="rounded-full w-[62px] h-[62px] bg-palmiak_pink flex relative transition-all duration-150 hover:bg-palmiak_lightdark hover:bg-opacity-40">
            <svg class="absolute inset-1/2 -translate-y-1/2 -translate-x-1/2 w-[30px] h-[30px]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://github.com/palmiak" target="about:blank" aria-label="GitHub"
            class="rounded-full w-[62px] h-[62px] bg-palmiak_blue flex relative transition-all duration-150 hover:bg-palmiak_lightdark hover:bg-opacity-40">
            <svg class="absolute inset-1/2 -translate-y-1/2 -translate-x-1/2 w-[30px] h-[30px]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <Picture
      src={herooImage}
      formats={['avif', 'webp']}
      alt=""
      width={1021}
      loading="eager"
      pictureAttributes={{
        class: "absolute max-[1023px]:static bottom-0 left-0 rounded-2xl z-10 overflow-hidden max-[1023px]:overflow-visible"
      }}
    />
  </div>
</section>
