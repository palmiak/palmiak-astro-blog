---
interface Props {
  title: string;
  /** Short sentence under the title */
  lede?: string;
  /** Render as the page's h1 */
  page?: boolean;
}
const { title, lede, page = false } = Astro.props;
const Tag = page ? 'h1' : 'h2';
---
<div class="sec-head">
  <Tag class="t-title-1">{title}</Tag>
  {lede && <p class="sec-lede">{lede}</p>}
</div>

<style>
.sec-lede {
  margin-top: var(--space-3);
  max-width: 34ch;
  font-size: 14px;
  line-height: 22px;
  color: var(--ink-muted);
}
</style>
