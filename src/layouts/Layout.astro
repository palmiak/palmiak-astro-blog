---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { u } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  isPost?: boolean;
}

const {
  title,
  description = 'Web developer, public speaker, Open Source enthusiast.',
  ogImage,
  isPost = false,
} = Astro.props;

const siteName = 'Maciek Palmowski';
const fullTitle = title ? `${title} | ${siteName}` : siteName;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" style="background:#0b0b0e;color-scheme:dark;">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="apple-touch-icon" sizes="180x180" href={u('/assets/fav/apple-touch-icon.png')} />
  <link rel="icon" type="image/png" sizes="32x32" href={u('/assets/fav/favicon-32x32.png')} />
  <link rel="icon" type="image/png" sizes="16x16" href={u('/assets/fav/favicon-16x16.png')} />
  <link rel="manifest" href={u('/assets/fav/site.webmanifest')} />
  <link rel="mask-icon" href={u('/assets/fav/safari-pinned-tab.svg')} color="#0b0b0e" />
  <meta name="msapplication-TileColor" content="#0b0b0e" />
  <meta name="theme-color" content="#0b0b0e" />

  <link rel="preload" href={u('/fonts/unbounded-v7-latin-regular.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={u('/fonts/unbounded-v7-latin-700.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={u('/fonts/instrument-serif-italic.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={u('/fonts/ibm-plex-mono-400.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={u('/fonts/inter-latin.woff2')} as="font" type="font/woff2" crossorigin />

  <title>{fullTitle}</title>

  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@palmiak_fp" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />}

  <script data-goatcounter="https://palmiak.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
</head>

<body style="background:var(--bg);color:var(--hi);font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased;min-height:100vh;">
  <Header isPost={isPost} />
  <slot />
  <Footer />
</body>
</html>
