---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Tag from '../components/Tag.astro';
import PostRow from '../components/PostRow.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import EuropeMap from '../components/EuropeMap.astro';
import Ticker from '../components/Ticker.astro';
import ScrollLit from '../components/ScrollLit.astro';
import { u } from '../utils/url';

const groups = [
  ['Surfaces', [['--bg', '#08090a', 'Page'], ['--surface-100', '#0e0f10', 'Row hover'], ['--surface-200', '#141517', 'Cards'], ['--surface-300', '#1b1c1f', 'Hover'], ['--surface-400', '#26272b', 'Pressed']]],
  ['Lines', [['--border-subtle', '#1d1e21', 'Decorative hairlines'], ['--border', '#2a2b2f', 'Card outlines, row rules'], ['--border-control', '#70717a', 'Interactive outlines']]],
  ['Text', [['--ink', '#ededee', 'Headings'], ['--ink-muted', '#a3a4aa', 'Body'], ['--ink-subtle', '#85868d', 'Captions']]],
  ['Accent', [['--accent', '#ff3d9a', 'Frame, focus, title dot, one CTA'], ['--accent-hover', '#ff70b4', 'Link hover'], ['--on-accent', '#0a0a0b', 'Text on pink']]],
  ['Status', [['--success', '#5fd3a0', 'Success'], ['--warning', '#e8b44f', 'Warning'], ['--danger', '#ff7a59', 'Danger']]],
] as const;

const samplePlaces = [
  { city: 'Florence', country: 'Italy', lat: 43.7696, lon: 11.2558, events: ['Open Source Day 2026'] },
  { city: 'Kraków', country: 'Poland', lat: 50.0647, lon: 19.945, events: ['WordCamp Europe 2026'] },
  { city: 'Gdynia', country: 'Poland', lat: 54.5189, lon: 18.5305, events: ['WordCamp Gdynia 2025'] },
  { city: 'Porto', country: 'Portugal', lat: 41.1579, lon: -8.6291, events: ['WordCamp Europe 2022'] },
  { city: 'Vilnius', country: 'Lithuania', lat: 54.6872, lon: 25.2797, events: ['CyberWiseCon 2025'] },
];

const galleryFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/*.{jpg,jpeg,png,webp}', { eager: true });
const shots = Object.entries(galleryFiles).sort(([a], [b]) => a.localeCompare(b)).slice(0, 3).map(([, m]) => m.default);

const sample = new Date('2026-03-22');
---
<Layout title="Style guide" noindex>
  <header class="wrap page-head">
    <h1 class="t-display">Hush<span class="hush-title-dot">.</span></h1>
    <p class="lede">A dark, quiet interface system: near-black surfaces, small type, hairlines instead of shadows, one pink signal used sparingly. Tokens live in <code>src/styles/tokens.css</code>, motion in <code>src/styles/motion.css</code>. This page shows the real components.</p>
  </header>

  <!-- Colour -->
  <section class="section hairline">
    <div class="wrap split">
      <SectionHeader title="Colour" lede="Elevation is one step lighter. Pink is an accent, not a theme." />
      <div class="stack">
        {groups.map(([name, items]) => (
          <div data-reveal>
            <h3 class="t-title-3 group-title">{name}</h3>
            <ul class="swatches">
              {items.map(([token, hex, role]) => (
                <li class="swatch">
                  <span class="chip" style={`background:var(${token})`}></span>
                  <span class="swatch-name">{token}</span>
                  <span class="swatch-hex">{hex}</span>
                  <span class="swatch-role">{role}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p class="note" data-reveal>Pink is used for the frame, focus ring, active-nav marker, selection wash, link hover, the title full stop, keywords in the about paragraph, the map dots and one filled button per view. Never for status, large fills or gradients.</p>
      </div>
    </div>
  </section>

  <!-- Type -->
  <section class="section hairline">
    <div class="wrap split">
      <SectionHeader title="Type" lede="Fraunces Light for titles, always upright. Geist for everything else." />
      <div class="stack">
        <div class="spec" data-rule><span class="t-caption">display-xl, home hero only, up to 168px</span><span class="t-display-xl spec-xl">Name<span class="hush-title-dot">.</span></span></div>
        <div class="spec" data-rule><span class="t-caption">display, 72 / 72</span><span class="t-display">Display<span class="hush-title-dot">.</span></span></div>
        <div class="spec" data-rule><span class="t-caption">title-1, 48 / 52</span><span class="t-title-1">Title one</span></div>
        <div class="spec" data-rule><span class="t-caption">title-2, 30 / 36</span><span class="t-title-2">Title two</span></div>
        <div class="spec" data-rule><span class="t-caption">title-3, 16 / 22, 500</span><span class="t-title-3">Title three</span></div>
        <div class="spec" data-rule><span class="t-caption">body, 14 / 22</span><span class="t-body">Body text reads quietly in ink-muted.</span></div>
        <div class="spec" data-rule><span class="t-caption">body-sm, 13 / 20</span><span class="t-body-sm">Body small for secondary copy.</span></div>
        <div class="spec" data-rule><span class="t-caption">caption, 12 / 16</span><span class="t-caption">Caption in ink-subtle</span></div>
        <div class="spec" data-rule><span class="t-caption">mono, 12.5 / 20</span><span class="t-mono">npm run build:check</span></div>
        <div class="spec" data-rule><span class="t-caption">post prose, 17 to 18 / 1.75</span><span class="prose-sample">Long-form reading is larger than the interface body, with links in ink and a pink hover.</span></div>
        <p class="note" data-reveal>Every title ends with a pink full stop. A title that already ends in a question or exclamation mark keeps it and drops the stop.</p>
      </div>
    </div>
  </section>

  <!-- Controls -->
  <section class="section hairline">
    <div class="wrap split">
      <SectionHeader title="Controls" lede="32px tall. At most one accent button per view." />
      <div class="stack">
        <div class="row" data-reveal>
          <button class="btn btn-primary" type="button">Primary</button>
          <button class="btn btn-secondary" type="button">Secondary</button>
          <button class="btn btn-ghost" type="button">Ghost</button>
          <button class="btn btn-accent" type="button">Accent</button>
          <button class="btn btn-secondary" type="button" disabled>Disabled</button>
          <a class="btn btn-secondary" href="#controls">
            With arrow
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
          </a>
        </div>
        <p class="note" data-reveal>Button and nav labels roll to a copy on hover. Hover states lift the surface one step; nothing is translucent.</p>
        <div class="row" data-reveal>
          <Tag tag="Astro" />
          <Tag tag="WordPress" />
          <Tag tag="Speaking" />
        </div>
        <div class="card" data-reveal>
          <h3 class="t-title-3">Card</h3>
          <p class="t-body-sm">surface-200, border, 16px padding, radius 8. No card inside a card.</p>
        </div>
        <div class="row icons" data-reveal>
          <span class="icon-demo" aria-label="Menu icon: a hamburger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 10.5c0-3.6 3.6-6 8-6s8 2.4 8 6Z" /><path d="M9 7.6h.01M12.5 6.5h.01M15.5 7.8h.01" stroke-width="2" />
              <path d="M4 13.2q2 1.6 4 0t4 0t4 0t4 0" /><rect x="4" y="15.2" width="16" height="2.4" rx="1.2" />
              <path d="M4 19.4h16c0 1.2-1 2-2.2 2H6.2C5 21.4 4 20.6 4 19.4Z" />
            </svg>
          </span>
          <span class="icon-demo" aria-label="Close icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg></span>
          <span class="t-caption">Menu button: a real hamburger that turns into a close mark</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation -->
  <section class="section hairline">
    <div class="wrap split">
      <SectionHeader title="Navigation" lede="One bar that changes with the page, never a second one." />
      <div class="stack">
        <div class="card" data-reveal>
          <h3 class="t-title-3">Header</h3>
          <p class="t-body-sm">Full-width and transparent at the top. Over the first 90px of scroll it narrows to the page container and becomes a floating bar: surface fill, border, blur and the floating-layer shadow. The logo stays on the page column. On phones the menu opens as a solid panel with staggered links.</p>
        </div>
        <ul class="index" data-reveal>
          <li><a href="#navigation"><span class="index-title">Contents row</span><span class="index-note">A quiet map of a long page</span></a></li>
          <li><a href="#navigation"><span class="index-title">Static</span><span class="index-note">No sticky second bar</span></a></li>
          <li><a href="#navigation"><span class="index-title">Hairlines</span><span class="index-note">Cells split by rules</span></a></li>
        </ul>
        <div class="toc-demo" data-reveal>
          <div class="t-caption">On this page</div>
          <ol>
            <li>What is it?</li>
            <li class="on">Why I won't use it</li>
            <li>Still worth watching</li>
          </ol>
        </div>
        <p class="note" data-reveal>Post outline: a pink marker slides to the heading being read.</p>
      </div>
    </div>
  </section>

  <!-- Rows -->
  <section class="section hairline">
    <div class="wrap split">
      <SectionHeader title="Rows" lede="Flat lists separated by hairlines that draw in as they scroll." />
      <div class="stack">
        <div class="rows">
          <PostRow title="An example post title that wraps onto two lines when it needs to" slug="example" tags={['Astro']} excerpt="Excerpt in body size and ink-muted, capped at a readable line length." pubDate={sample} />
          <PostRow title="A shorter title" slug="example-2" tags={['WordPress']} pubDate={sample} />
        </div>
        <ul class="events">
          <li class="event" data-rule>
            <div class="event-inner" data-reveal>
              <div class="event-main"><span class="event-name">WordCamp Europe 2026</span><span class="event-meta">Jun · Kraków, Poland · Testing the promise: does secure hosting deliver?</span></div>
              <div class="event-side"><span class="badges"><span class="badge">Speaker</span><span class="badge">Organiser</span></span><span class="event-links"><a href="#rows">Video</a><a href="#rows">Event</a></span></div>
            </div>
          </li>
          <li class="event last" data-rule>
            <div class="event-inner" data-reveal>
              <div class="event-main"><span class="event-name">WordCamp Santa Clarita 2021</span><span class="event-meta">Jul · Online</span></div>
              <div class="event-side"><span class="badges"><span class="badge">Online</span></span></div>
            </div>
          </li>
        </ul>
        <p class="note" data-reveal>One rule per row, never a double line. Rows step to surface-100 on hover and show a pink arrow.</p>
      </div>
    </div>
  </section>

  <!-- Speaking -->
  <section class="section hairline">
    <div class="wrap split">
      <SectionHeader title="Map and figures" lede="A dotted Europe: one pink dot per city, drawn in as you scroll." />
      <div class="stack">
        <div class="map-grid">
          <EuropeMap places={samplePlaces} />
          <dl class="figures" data-reveal>
            <div><dt>Appearances</dt><dd>47</dd></div>
            <div><dt>Cities</dt><dd>19</dd></div>
            <div><dt>Countries</dt><dd>7</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Imagery -->
  <section class="section hairline">
    <div class="wrap split">
      <SectionHeader title="Imagery" lede="Photos sit in a hairline frame. Pointing at one lifts it and quiets the rest." />
      <div class="stack">
        <div class="gallery" data-reveal>
          {shots.map((img) => (
            <figure class="shot">
              <Image src={img} alt="Speaking at a conference" widths={[320, 640]} sizes="(max-width: 720px) 50vw, 30vw" />
            </figure>
          ))}
        </div>
        <p class="note" data-reveal>No zoom. Hover lifts 4px and dims the siblings; it only runs where a pointer can hover.</p>
      </div>
    </div>
  </section>

  <!-- Text and motion -->
  <section class="section hairline">
    <div class="wrap">
      <SectionHeader title="Text and motion" lede="Scroll to see the paragraph light up and the strip move." />
      <div class="demo-lit">
        <ScrollLit keywords={['Hush', 'pink']} text="Hush is dark and quiet, with one pink signal. Keywords can take the accent, and every word fades in as the paragraph passes through the viewport." />
      </div>
    </div>
    <Ticker items={['WordCamp Europe', 'Open Source Day', 'WordCamp Gdynia', 'CMS Conf', 'Joomla! World Conference']} />
    <div class="wrap">
      <ul class="notes">
        <li><strong>Load.</strong> The home hero name rises line by line, then the copy follows. Letters of the name thicken from 300 to 450 near the pointer.</li>
        <li><strong>Header.</strong> Morphs from a full-width bar to a floating container-width bar over the first 90px.</li>
        <li><strong>Hero.</strong> Pinned while the next section rises; the bio leaves first, the name recedes.</li>
        <li><strong>Scroll.</strong> Rows and hairlines draw in, words light up, the sign-off wipes in, the map and its cities draw in, the ticker moves only while you scroll.</li>
        <li><strong>Menu.</strong> The mobile panel reveals from the top, links rise in one after another, the burger turns into a close mark.</li>
        <li><strong>Scrolling.</strong> Inertia scrolling on wheel and trackpad. Touch keeps native momentum.</li>
        <li><strong>Reduced motion.</strong> Everything shows its final state with no transforms.</li>
      </ul>
    </div>
  </section>

  <!-- Social images -->
  <section class="section hairline">
    <div class="wrap split">
      <SectionHeader title="Social images" lede="Generated with Takumi for every page and post." />
      <div class="stack">
        <div class="og-grid" data-reveal>
          <Image src={u('/og/home.png')} width={600} height={315} alt="Home page social image: Developer and speaker." />
          <Image src={u('/og/speaking.png')} width={600} height={315} alt="Speaking page social image." />
        </div>
        <p class="note" data-reveal>Pink frame, dot grid, Fraunces title ending in a pink full stop, the wordmark, and a pink call-to-action button, because some networks hide the link. Source: <code>src/utils/og.ts</code>.</p>
      </div>
    </div>
  </section>

  <NewsletterBox variant="home" />
</Layout>

<style>
.split { display: grid; gap: var(--space-12); }
@media (min-width: 960px) {
  .split { grid-template-columns: 280px minmax(0, 1fr); align-items: start; }
  .split > :first-child { position: sticky; top: calc(var(--frame) + var(--header-h) + 32px); }
}
.stack { display: flex; flex-direction: column; gap: var(--space-8); min-width: 0; }
.note { max-width: 62ch; font-size: 13px; line-height: 20px; color: var(--ink-subtle); }
.group-title { margin-bottom: var(--space-3); }

.swatches { list-style: none; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-100); }
.swatch { display: grid; grid-template-columns: 32px minmax(110px, 1fr) 80px minmax(0, 1.4fr); gap: var(--space-4); align-items: center; padding: var(--space-3) var(--space-4); border-top: 1px solid var(--border-subtle); }
.swatch:first-child { border-top: 0; }
.chip { width: 32px; height: 20px; border-radius: var(--radius-sm); border: 1px solid var(--border-control); }
.swatch-name, .swatch-hex { font-family: var(--font-mono); font-size: 12.5px; color: var(--ink); }
.swatch-hex { color: var(--ink-muted); }
.swatch-role { font-size: 13px; color: var(--ink-subtle); }
@media (max-width: 640px) { .swatch { grid-template-columns: 32px minmax(0, 1fr) 80px; } .swatch-role { display: none; } }

.spec { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: var(--space-6); align-items: baseline; padding-block: var(--space-4); border-top: 1px solid var(--border); }
.spec-xl { font-size: clamp(56px, 9vw, 120px); }
.prose-sample { font-size: 17px; line-height: 1.75; max-width: 52ch; }
@media (max-width: 640px) { .spec { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); } }

.row { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
.card { max-width: 440px; padding: var(--space-4); background: var(--surface-200); border: 1px solid var(--border); border-radius: var(--radius-lg); }
.card p { margin-top: var(--space-1); color: var(--ink-muted); }
.icon-demo { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: var(--radius-md); color: var(--ink); }
.icon-demo svg { width: 22px; height: 22px; }
.icons { gap: var(--space-3); }

/* contents row */
.index { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--border); }
.index li { border-bottom: 1px solid var(--border); }
.index li:not(:first-child) { border-left: 1px solid var(--border-subtle); }
.index a { display: flex; flex-direction: column; gap: var(--space-1); height: 100%; padding: var(--space-4); text-decoration: none; transition: background-color var(--dur-hover) var(--ease-in); }
.index a:hover { background: var(--surface-100); }
.index-title { font-size: 15px; line-height: 22px; font-weight: 500; color: var(--ink); }
.index-note { font-size: 13px; line-height: 20px; color: var(--ink-muted); }
@media (max-width: 640px) { .index { grid-template-columns: minmax(0, 1fr); } .index li:not(:first-child) { border-left: 0; } }

.toc-demo { max-width: 260px; }
.toc-demo ol { list-style: none; margin-top: var(--space-2); border-left: 1px solid var(--border); }
.toc-demo li { position: relative; padding: 4px 0 4px 12px; font-size: 13px; line-height: 20px; color: var(--ink-subtle); }
.toc-demo li.on { color: var(--ink); }
.toc-demo li.on::before { content: ""; position: absolute; left: -1px; top: 4px; bottom: 4px; width: 2px; border-radius: 1px; background: var(--accent); }

/* rows */
.rows { min-width: 0; }
.events { list-style: none; }
.event { border-top: 1px solid var(--border); }
.event.last { border-bottom: 1px solid var(--border); }
.event-inner { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-6); padding: var(--space-4) var(--space-2); }
.event-main { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
.event-name { font-size: 15px; line-height: 22px; font-weight: 500; color: var(--ink); }
.event-meta { font-size: 13px; line-height: 20px; color: var(--ink-muted); }
.event-side { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-2); flex-shrink: 0; }
.badges { display: flex; gap: var(--space-1); }
.event-links { display: flex; gap: var(--space-3); }
.event-links a { font-size: 13px; line-height: 20px; color: var(--ink-muted); text-decoration: underline; text-decoration-color: var(--border-control); text-underline-offset: 3px; }
@media (max-width: 640px) { .event-inner { flex-direction: column; gap: var(--space-2); } .event-side { flex-direction: row; align-items: center; flex-wrap: wrap; } }

/* map and figures */
.map-grid { display: grid; gap: var(--space-8); align-items: start; }
@media (min-width: 900px) { .map-grid { grid-template-columns: minmax(0, 1fr) 220px; } }
.figures { display: grid; }
.figures > div { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); padding-block: var(--space-3); border-top: 1px solid var(--border); }
.figures > div:last-child { border-bottom: 1px solid var(--border); }
.figures dt { font-size: 13px; line-height: 20px; color: var(--ink-muted); }
.figures dd { margin: 0; font-family: var(--font-title); font-weight: 300; font-size: 44px; line-height: 1; letter-spacing: -0.05em; color: var(--ink); }

/* gallery */
.gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
.shot { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-200); transition: translate var(--dur-panel) var(--ease-in), border-color var(--dur-hover) var(--ease-in); }
.shot :global(img) { width: 100%; height: 100%; object-fit: cover; transition: filter var(--dur-panel) var(--ease-in); }
.shot:hover { translate: 0 -4px; border-color: var(--border-control); }
@media (hover: hover) { .gallery:has(.shot:hover) .shot:not(:hover) :global(img) { filter: brightness(0.45) saturate(0.7); } }
@media (max-width: 640px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

.demo-lit { padding-block: var(--space-8) var(--space-12); }
.notes { list-style: none; display: flex; flex-direction: column; gap: var(--space-4); max-width: 64ch; margin-top: var(--space-8); font-size: 15px; line-height: 24px; color: var(--ink-muted); }
.notes strong { color: var(--ink); font-weight: 500; }

.og-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(2, minmax(0, 1fr)); }
.og-grid :global(img) { width: 100%; height: auto; border: 1px solid var(--border); border-radius: var(--radius-lg); }
@media (max-width: 640px) { .og-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
