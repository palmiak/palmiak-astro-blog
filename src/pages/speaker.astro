---
import Layout from '../layouts/Layout.astro';
import GradBar from '../components/GradBar.astro';
import { Image } from 'astro:assets';

import imgColor from '../assets/speaker/maciek_color.jpg';
import imgBw from '../assets/speaker/maciek_bw.jpg';
import imgProfile from '../assets/speaker/maciek_profile.jpg';
import imgSlack from '../assets/speaker/maciek_slack.jpg';

const photos = [
  { img: imgColor, file: 'maciek_color.jpg', label: 'Color photo', desc: 'Color portrait' },
  { img: imgBw, file: 'maciek_bw.jpg', label: 'Black & white', desc: 'B&W portrait' },
  { img: imgProfile, file: 'maciek_profile.jpg', label: 'Profile photo', desc: 'Profile picture' },
  { img: imgSlack, file: 'maciek_slack.jpg', label: 'Slack avatar', desc: 'Square avatar' },
];

const bios = [
  {
    id: 'en-1st',
    lang: 'English',
    person: '1st person',
    text: "I'm a Growth Engineer at Patchstack. I'm a huge fan of Open Source, Content Management Systems, and automation. After hours, I spend most of my time finding interesting cycling routes, coding side projects, or drinking coffee.",
  },
  {
    id: 'en-3rd',
    lang: 'English',
    person: '3rd person',
    text: "Maciek is a Growth Engineer at Patchstack. He's a huge fan of Open Source, Content Management Systems, and automation. After hours, he spends most of his time finding interesting cycling routes, coding side projects, or drinking coffee.",
  },
  {
    id: 'pl-1st',
    lang: 'Polski',
    person: '1 osoba',
    text: 'Pracuję jako Growth Engineer w Patchstack. Jestem ogromnym fanem Open Source, CMS-ów oraz automatyzacji. Wolny czas spędzam, znajdując nieznane ścieżki rowerowe, kodując albo popijając kawę.',
  },
  {
    id: 'pl-3rd',
    lang: 'Polski',
    person: '3 osoba',
    text: 'Maciek pracuje jako Growth Engineer w Patchstack. Jest ogromnym fanem Open Source, CMS-ów oraz automatyzacji. Wolny czas spędza, znajdując nieznane ścieżki rowerowe, kodując albo popijając kawę.',
  },
];
---

<Layout title="Speaker Kit" description="Speaker bios and photos for Maciek Palmowski">
  <div class="spk-header">
    <div class="col">
      <div class="sec-label"><span class="sec-dot"></span>Speaking</div>
      <h1 class="page-title">Speaker Kit</h1>
      <p class="page-sub">Bios and photos for conference organizers and event materials.</p>
    </div>
  </div>

  <GradBar />

  <!-- Bios -->
  <section class="spk-section">
    <div class="col">
      <h2 class="section-title">Bio</h2>

      <div class="tab-bar" role="tablist">
        {bios.map((bio, i) => (
          <button
            class="tab-btn"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${bio.id}`}
            id={`tab-${bio.id}`}
            data-tab={bio.id}
          >
            <span class="tab-lang">{bio.lang}</span>
            <span class="tab-person">{bio.person}</span>
          </button>
        ))}
      </div>

      {bios.map((bio, i) => (
        <div
          class="bio-panel"
          role="tabpanel"
          id={`panel-${bio.id}`}
          aria-labelledby={`tab-${bio.id}`}
          hidden={i !== 0}
          data-panel={bio.id}
        >
          <p class="bio-text">{bio.text}</p>
          <button class="copy-btn" data-copy={bio.text}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copy-label">Copy</span>
          </button>
        </div>
      ))}
    </div>
  </section>

  <GradBar />

  <!-- Photos -->
  <section class="spk-section">
    <div class="col">
      <h2 class="section-title">Photos</h2>
      <p class="section-sub">Click to download in full resolution.</p>
      <div class="photo-grid">
        {photos.map((photo) => (
          <a
            class="photo-card"
            href={photo.img.src}
            download={photo.file}
            aria-label={`Download ${photo.label}`}
          >
            <div class="photo-wrap">
              <Image
                src={photo.img}
                alt={photo.desc}
                loading="lazy"
                widths={[320, 640]}
                sizes="(max-width: 320px) 320px, 640px"
              />
              <div class="photo-overlay">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Download
              </div>
            </div>
            <div class="photo-label">{photo.label}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <GradBar />
</Layout>

<script>
  // Tabs
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.bio-panel');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;

      tabBtns.forEach((b) => b.setAttribute('aria-selected', 'false'));
      panels.forEach((p) => { p.hidden = true; });

      btn.setAttribute('aria-selected', 'true');
      const panel = document.querySelector<HTMLElement>(`[data-panel="${target}"]`);
      if (panel) panel.hidden = false;
    });
  });

  // Copy buttons
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy!;
      try {
        await navigator.clipboard.writeText(text);
        const label = btn.querySelector('.copy-label')!;
        label.textContent = 'Copied!';
        setTimeout(() => { label.textContent = 'Copy'; }, 2000);
      } catch {
        // fallback: select text manually
      }
    });
  });
</script>

<style>
.col {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 24px;
}
.spk-header {
  padding: 56px 0 32px;
  border-bottom: 1px solid var(--bd);
}
.sec-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--mid);
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}
.sec-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff2d78, #a855f7);
  flex-shrink: 0;
}
.page-title {
  font-family: 'Unbounded', sans-serif;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--hi);
  margin: 0 0 10px;
}
.page-sub {
  color: var(--mid);
  font-size: 14px;
  margin: 0;
}

/* Section */
.spk-section {
  padding: 48px 0;
  border-bottom: 1px solid var(--bd);
}
.section-title {
  font-family: 'Unbounded', sans-serif;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--hi);
  margin: 0 0 8px;
}
.section-sub {
  color: var(--mid);
  font-size: 13px;
  margin: 0 0 24px;
}

/* Tabs */
.tab-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0 24px;
}
.tab-btn {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  padding: 10px 16px;
  background: var(--bg1, #111116);
  border: 1px solid var(--bd);
  border-radius: 6px;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}
.tab-btn:hover {
  border-color: var(--bd2);
}
.tab-btn[aria-selected="true"] {
  border-color: #a855f7;
  background: rgba(168, 85, 247, 0.08);
}
.tab-lang {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  font-weight: 600;
  color: var(--hi);
  letter-spacing: 0.05em;
}
.tab-person {
  font-size: 11px;
  color: var(--mid);
}

/* Bio panel */
.bio-panel {
  background: var(--bg1, #111116);
  border: 1px solid var(--bd);
  border-radius: 8px;
  padding: 24px;
}
.bio-text {
  font-size: 15px;
  line-height: 1.7;
  color: var(--hi);
  margin: 0 0 20px;
}
.copy-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 16px;
  background: transparent;
  border: 1px solid var(--bd);
  border-radius: 6px;
  color: var(--mid);
  font-size: 12px;
  font-family: 'IBM Plex Mono', monospace;
  letter-spacing: 0.05em;
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s;
}
.copy-btn:hover {
  border-color: var(--bd2);
  color: var(--hi);
}

/* Photos */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 16px;
  margin-top: 24px;
}
.photo-card {
  text-decoration: none;
  color: inherit;
}
.photo-wrap {
  position: relative;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid var(--bd);
  aspect-ratio: 1;
  background: var(--bg1, #111116);
}
.photo-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.2s;
}
.photo-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: rgba(11, 11, 14, 0.75);
  color: #fff;
  font-size: 12px;
  font-family: 'IBM Plex Mono', monospace;
  letter-spacing: 0.08em;
  opacity: 0;
  transition: opacity 0.2s;
}
.photo-card:hover .photo-overlay {
  opacity: 1;
}
.photo-card:hover .photo-wrap img {
  transform: scale(1.03);
}
.photo-label {
  font-size: 12px;
  color: var(--mid);
  margin-top: 8px;
  font-family: 'IBM Plex Mono', monospace;
  letter-spacing: 0.05em;
}
</style>
