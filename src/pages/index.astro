---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { u } from '../utils/url';
import { SITE } from '../utils/site';
import Hero from '../components/Hero.astro';
import ScrollLit from '../components/ScrollLit.astro';
import Ticker from '../components/Ticker.astro';
import { getAppearances, speakingStats } from '../data/speaking';
import SectionHeader from '../components/SectionHeader.astro';
import PostRow from '../components/PostRow.astro';
import NewsletterBox from '../components/NewsletterBox.astro';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentPosts = allPosts.slice(0, 8);

const appearances = await getAppearances();
const stats = speakingStats(appearances);
const monthName = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const recentTalks = appearances.filter((a) => a.role === 'speaker' || a.role === 'organiser').slice(0, 6);
const linkOf = (a: (typeof appearances)[number]) => {
  const first = a.links?.find((l) => l.label !== 'Resources') ?? a.links?.[0];
  return first ? (first.url.startsWith('/') ? u(first.url) : first.url) : undefined;
};

const eventNames = [...new Set(appearances.filter((a) => a.role === 'speaker' || a.role === 'organiser').map((a) => a.event.replace(/ 20\d{2}$/, '')))];
---
<Layout title="Home" ogImage={u('/og/home.png')}>
  <Hero />

  <!-- Writing -->
  <section class="section hairline" id="writing">
    <div class="wrap split">
      <div class="split-head">
        <SectionHeader title="Writing" lede={`${allPosts.length} posts on WordPress, headless CMS, Astro and speaking.`} />
        <a class="btn btn-secondary all-link" href={u('/blog')}>
          All posts
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        </a>
      </div>
      <div class="posts-list">
        {recentPosts.map((post) => (
          <PostRow
            title={post.data.title}
            slug={post.slug}
            tags={post.data.tags}
            excerpt={post.data.excerpt ?? post.data.description}
            pubDate={post.data.pubDate}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section hairline about" id="about">
    <div class="wrap">
      <ScrollLit keywords={['Patchstack', 'headless architecture', 'Astro', 'CMS Conf 2026', 'gravel bike']} text="I'm a web developer and Growth Engineer at Patchstack, the WordPress security company. Over 15 years I've gone deep on WordPress, PHP, headless architecture and Astro, and I write and speak about all of it. I co-organise CMS Conf 2026 in Gdynia, Poland. When I'm away from the keyboard I'm on a gravel bike." />
      <div class="about-actions" data-reveal>
        <a class="btn btn-secondary" href={u('/contact-me')}>Get in touch</a>
        <a class="btn btn-ghost" href={u('/speaking')}>Speaking</a>
      </div>
    </div>
  </section>

  <Ticker items={eventNames} />

  <!-- Speaking -->
  <section id="speaking" class="section hairline">
    <div class="wrap split">
      <div class="split-head">
        <SectionHeader title="Speaking" lede={`${stats.appearances} talks and workshops in ${stats.cities} cities since ${stats.since}.`} />
        <a class="btn btn-secondary all-link" href={u('/speaking')}>
          Talks, map and speaker kit
          <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        </a>
      </div>
      <ul class="talks-list">
        {recentTalks.map((a) => {
          const url = linkOf(a);
          return (
            <li class="talk-row" data-rule>
              <div class="talk-inner" data-reveal>
                <div class="talk-main">
                  {url ? (
                    <a href={url} {...(url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})} class="talk-title talk-link">{a.event}</a>
                  ) : (
                    <span class="talk-title">{a.event}</span>
                  )}
                  <span class="talk-event">{a.city ? `${a.city}, ${a.country}` : 'Online'}{a.talk ? `. ${a.talk}` : ''}</span>
                </div>
                <span class="talk-year">{a.month ? `${monthName[a.month - 1]} ` : ''}{a.year}</span>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <NewsletterBox variant="home" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE}/#person`,
    name: 'Maciek Palmowski',
    url: SITE,
    jobTitle: 'Growth Engineer',
    worksFor: { '@type': 'Organization', name: 'Patchstack' },
    sameAs: [
      'https://bsky.app/profile/maciekpalmowski.dev',
      'https://twitter.com/palmiak_fp',
      'https://www.linkedin.com/in/maciekpalmowski/',
      'https://github.com/palmiak',
    ],
    knowsAbout: ['WordPress security', 'Headless CMS', 'Astro', 'Web development'],
  })} />
</Layout>

<style>
/* Writing follows the pinned hero, so it needs less lead-in space */
#writing { padding-top: clamp(40px, 6vw, 72px); }

.split {
  display: grid;
  gap: var(--space-12);
}
.split-head { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); }
@media (min-width: 960px) {
  .split { grid-template-columns: 280px minmax(0, 1fr); gap: var(--space-12); align-items: start; }
  .split-head { position: sticky; top: calc(var(--frame) + var(--header-h) + 32px); }
}

.posts-list { min-width: 0; }

.about-actions { display: flex; gap: var(--space-2); margin-top: var(--space-12); flex-wrap: wrap; }

.talks-list { list-style: none; min-width: 0; }
.talk-row { border-top: 1px solid var(--border); transition: background-color var(--dur-hover) var(--ease-in); }
.talk-row:last-child { border-bottom: 1px solid var(--border); }
.talk-row:hover { background: var(--surface-100); }
.talk-inner {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--space-6);
  padding: var(--space-6) var(--space-2);
}
.talk-main { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
.talk-title {
  font-family: var(--font-title);
  font-weight: 300;
  font-size: clamp(20px, 2.4vw, 24px);
  line-height: 1.25;
  letter-spacing: -0.025em;
  color: var(--ink);
  text-decoration: none;
  text-wrap: balance;
}
.talk-link { transition: color var(--dur-hover) var(--ease-in); }
.talk-link::after { content: ""; position: absolute; inset: 0; }
.talk-row { position: relative; }
.talk-link:hover { color: var(--accent-hover); }
.talk-event { font-size: 13px; line-height: 20px; color: var(--ink-subtle); }
.talk-year { font-family: var(--font-mono); font-size: 12.5px; line-height: 20px; color: var(--ink-subtle); flex-shrink: 0; }
</style>
