---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { u } from '../../utils/url';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { name, logo, links } = event.data;
---

<Layout title={name} description={`Slides and resources from Maciek Palmowski's session at ${name}.`} ogImage={u(`/events/${event.id}/og.png`)} ogImageAlt={name}>
  <div class="linktree">
    <div class="profile">
      <div class="profile-images">
        <Image
          src={u('/assets/me.jpg')}
          width={96}
          height={96}
          alt="Maciek Palmowski"
          class="avatar"
        />
        <Image
          src={logo}
          width={96}
          height={96}
          alt={name}
          class="event-logo"
        />
      </div>
      <h1 class="event-name t-title-1">{name}</h1>
    </div>

    <ul class="links-list">
      {links.map((link) => (
        <li data-reveal>
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-btn">
            <span>{link.label}</span>
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
.linktree {
  min-height: calc(100svh - var(--frame) * 2 - var(--header-h));
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: clamp(48px, 8vw, 96px) var(--gutter) 96px;
}
.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-6);
  margin-bottom: var(--space-12);
}
.profile-images { display: flex; align-items: center; gap: var(--space-6); }
.avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  object-fit: cover;
  border: 1px solid var(--border);
}
.event-logo { width: 96px; height: 96px; object-fit: contain; }
.event-name { text-align: center; max-width: 18ch; }

.links-list {
  list-style: none;
  width: 100%;
  max-width: 560px;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.link-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding: var(--space-4);
  font-size: 14px;
  line-height: 22px;
  color: var(--ink);
  text-decoration: none;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  background: var(--surface-200);
  transition: background-color var(--dur-hover) var(--ease-in), border-color var(--dur-hover) var(--ease-in);
}
.link-btn svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--ink-muted); transition: transform var(--dur-fade) var(--ease-in), color var(--dur-fade) var(--ease-in); }
.link-btn:hover { background: var(--surface-300); border-color: var(--border-control); }
.link-btn:hover svg { transform: translate(2px, -2px); color: var(--accent); }
.link-btn:active { background: var(--surface-400); }
</style>
