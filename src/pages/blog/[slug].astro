---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { u } from '../../utils/url';
import { SITE, abs } from '../../utils/site';
import Tag from '../../components/Tag.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const outline = headings.filter((h) => h.depth === 2);

const { title, intro, description, pubDate, updatedDate, thumbnail, tags } = post.data;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,svg}'
);
const thumbKey = thumbnail ? `/src/assets/${thumbnail}` : null;
const thumbMetadata = thumbKey && allImages[thumbKey]
  ? (await allImages[thumbKey]()).default
  : null;

const dateStr = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const currentUrl = abs(Astro.url.pathname);

// Prev/next posts
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const siteUrl = SITE;

const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description ?? intro ?? '',
  url: currentUrl,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  author: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Maciek Palmowski',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: 'Maciek Palmowski',
    url: siteUrl,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': currentUrl },
  image: abs(u(`/blog/${post.slug}/og.png`)),
  inLanguage: 'en',
  articleSection: tags[0],
  keywords: tags.join(', '),
});

const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: currentUrl },
  ],
});
---
<Layout
  title={title}
  description={description}
  ogImage={u(`/blog/${post.slug}/og.png`)}
  ogImageAlt={title}
  ogType="article"
  markdownUrl={abs(u(`/blog/${post.slug}.md`))}
  article={{ published: pubDate, modified: updatedDate, tags }}
  isPost={true}
>
  <header class="post-header">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href={u('/')} class="crumb-link">Home</a>
        <span aria-hidden="true">/</span>
        <a href={u('/blog')} class="crumb-link">Blog</a>
      </nav>

      <div class="post-top">
        <time class="post-date" datetime={pubDate.toISOString()}>{dateStr}</time>
        {tags.slice(0, 2).map((tag) => <Tag tag={tag} />)}
      </div>
      <h1 class="post-title t-display">{title}</h1>
      {intro && <p class="post-lede">{intro}</p>}
    </div>

    {thumbnail && (
      <div class="wrap hero-img-wrap">
        <div class="hero-img-frame">
          {thumbMetadata ? (
            <Image
              src={thumbMetadata}
              width={1360}
              height={595}
              alt={title}
              class="hero-img"
              loading="eager"
              data-zoom
            />
          ) : (
            <img src={`/assets/${thumbnail}`} width="1360" height="595" alt={title} class="hero-img" data-zoom />
          )}
        </div>
      </div>
    )}
  </header>

  <div class="wrap editorial-wrap">
    <div class="editorial-inner">
      <article class="article-col">
        <div class="prose-post">
          <Content />
        </div>
      </article>

      <aside class="article-sidebar" aria-label="About this post">
        <div class="sidebar-section sidebar-author">
          <img class="author-av" src={u('/assets/me.jpg')} alt="" width="40" height="40" />
          <div>
            <div class="author-name">Maciek Palmowski</div>
            <div class="author-role">Growth Engineer, Patchstack</div>
          </div>
        </div>

        {outline.length >= 2 && (
          <div class="sidebar-section sidebar-toc" data-toc>
            <div class="sidebar-label">On this page</div>
            <nav class="toc-box" aria-label="On this page" data-lenis-prevent>
              <span class="toc-marker" aria-hidden="true"></span>
              <ol class="toc-list">
                {outline.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              </ol>
            </nav>
          </div>
        )}

        <div class="sidebar-section">
          <div class="sidebar-label">Published</div>
          <div class="sidebar-value">{dateStr}</div>
          {updatedDate && (
            <div class="sidebar-value sidebar-updated">
              Updated {updatedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
            </div>
          )}
        </div>

        {tags.length > 0 && (
          <div class="sidebar-section">
            <div class="sidebar-label">Topics</div>
            <div class="sidebar-tag-list">
              {tags.map((tag) => (
                <a href={u(`/tags/${tag}`)} class="sidebar-tag-link"><Tag tag={tag} /></a>
              ))}
            </div>
          </div>
        )}

        <div class="sidebar-section">
          <div class="sidebar-label">Share</div>
          <div class="share-row">
            <a
              class="btn btn-secondary"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(currentUrl)}`}
              target="_blank"
              rel="noopener"
            >Share on X</a>
            <a
              class="btn btn-secondary"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`}
              target="_blank"
              rel="noopener"
            >Share on LinkedIn</a>
          </div>
        </div>

        <div class="sidebar-section">
          <a href="#discussion" class="btn btn-ghost jump">Jump to comments</a>
        </div>
      </aside>
    </div>
  </div>

  <NewsletterBox variant="post" />

  {(prevPost || nextPost) && (
    <nav class="wrap post-nav-wrap" aria-label="More posts">
      <div class="post-nav">
        {prevPost ? (
          <a class="pnav prev" href={u(`/blog/${prevPost.slug}`)}>
            <div class="pnav-dir">Previous post</div>
            <div class="pnav-title t-title-2">{prevPost.data.title}</div>
          </a>
        ) : <div class="pnav empty"></div>}

        {nextPost ? (
          <a class="pnav next" href={u(`/blog/${nextPost.slug}`)}>
            <div class="pnav-dir">Next post</div>
            <div class="pnav-title t-title-2">{nextPost.data.title}</div>
          </a>
        ) : <div class="pnav empty"></div>}
      </div>
    </nav>
  )}

  <section class="wrap wrap-narrow comments-section hairline" id="discussion">
    <h2 class="t-title-2 comments-title">Share your thoughts</h2>
    <script
      src="https://giscus.app/client.js"
      data-repo="palmiak/blog-comments"
      data-repo-id="R_kgDOKSw90A"
      data-category="General"
      data-category-id="DIC_kwDOKSw90M4CZQxJ"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="transparent_dark"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </section>

  <script type="application/ld+json" is:inline set:html={articleJsonLd} />
  <script type="application/ld+json" is:inline set:html={breadcrumbJsonLd} />

  <script>
    import '../../scripts/main.ts';
    import '../../scripts/toc.ts';
  </script>
</Layout>

<style>
/* Header */
.post-header { padding-top: clamp(32px, 5vw, 56px); }
.crumb {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: 13px;
  line-height: 16px;
  color: var(--ink-subtle);
  margin-bottom: clamp(32px, 6vw, 72px);
}
.crumb-link { color: var(--ink-muted); text-decoration: none; transition: color var(--dur-hover) var(--ease-in); }
.crumb-link:hover { color: var(--ink); }
.post-top { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-6); flex-wrap: wrap; }
.post-date { font-family: var(--font-mono); font-size: 12.5px; line-height: 20px; color: var(--ink-subtle); }
.post-title { max-width: 18ch; font-size: clamp(40px, 7vw, 72px); }
.post-lede {
  max-width: 56ch;
  margin-top: var(--space-6);
  font-size: clamp(17px, 2vw, 20px);
  line-height: 1.6;
  color: var(--ink-muted);
}

/* Hero image */
.hero-img-wrap { margin-top: clamp(32px, 5vw, 56px); }
.hero-img-frame {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
}
.hero-img { width: 100%; aspect-ratio: 16 / 7; object-fit: cover; display: block; }

/* Two columns: article + sidebar */
.editorial-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  gap: clamp(40px, 6vw, 88px);
  align-items: start;
  padding-block: clamp(40px, 6vw, 72px) clamp(48px, 7vw, 88px);
}
.article-col { min-width: 0; max-width: 700px; }
.article-col :global(.image.wide) { position: static; left: 0; transform: none; width: 100%; }

.article-sidebar {
  position: sticky;
  top: calc(var(--frame) + var(--header-h) + 24px);
  order: 2;
}
.sidebar-section { padding: var(--space-4) 0; border-top: 1px solid var(--border-subtle); }
.sidebar-section:first-child { border-top: 0; padding-top: 0; }
.sidebar-label { font-size: 12px; line-height: 16px; color: var(--ink-subtle); margin-bottom: var(--space-2); }
.sidebar-value { font-family: var(--font-mono); font-size: 12.5px; line-height: 20px; color: var(--ink); }
.sidebar-updated { color: var(--ink-subtle); }

.sidebar-author { display: flex; align-items: center; gap: var(--space-3); }
.author-av { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; object-position: center top; border: 1px solid var(--border); flex-shrink: 0; }
.author-name { font-size: 14px; line-height: 20px; font-weight: 500; color: var(--ink); }
.author-role { font-size: 12px; line-height: 16px; color: var(--ink-subtle); }

.sidebar-tag-list { display: flex; flex-wrap: wrap; gap: var(--space-2); }
.sidebar-tag-link { text-decoration: none; border-radius: var(--radius-sm); }
.sidebar-tag-link :global(.badge) { transition: background-color var(--dur-hover) var(--ease-in), color var(--dur-hover) var(--ease-in); }
.sidebar-tag-link:hover :global(.badge) { background: var(--surface-200); color: var(--ink); }

.share-row { display: flex; flex-direction: column; gap: var(--space-2); align-items: stretch; }
.jump { margin-left: -12px; }

/* On this page */
.toc-box {
  position: relative;
  max-height: max(160px, calc(100vh - 460px));
  overflow-y: auto;
  scrollbar-width: none;
  border-left: 1px solid var(--border);
}
.toc-box::-webkit-scrollbar { display: none; }
.toc-list { list-style: none; }
.toc-list :global(a) {
  display: block;
  padding: 4px 0 4px 12px;
  font-size: 13px;
  line-height: 20px;
  color: var(--ink-subtle);
  text-decoration: none;
  transition: color var(--dur-hover) var(--ease-in);
}
.toc-list :global(a:hover) { color: var(--ink-muted); }
.toc-list :global(a[aria-current]) { color: var(--ink); }
.toc-marker {
  position: absolute;
  left: -1px;
  top: 0;
  width: 2px;
  height: 20px;
  background: var(--accent);
  border-radius: 1px;
  opacity: 0;
  transition: transform var(--dur-panel) var(--ease-in), height var(--dur-panel) var(--ease-in), opacity var(--dur-fade) var(--ease-in);
}

/* Prev / next */
.post-nav-wrap { padding-bottom: var(--space-12); }
.post-nav { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.pnav {
  display: block;
  padding: var(--space-8) var(--space-6);
  text-decoration: none;
  color: inherit;
  transition: background-color var(--dur-hover) var(--ease-in);
}
.pnav + .pnav { border-left: 1px solid var(--border); }
.pnav.next { text-align: right; }
.pnav:not(.empty):hover { background: var(--surface-100); }
.pnav-dir { font-size: 12px; line-height: 16px; color: var(--ink-subtle); margin-bottom: var(--space-3); }
.pnav-title { transition: color var(--dur-hover) var(--ease-in); }
.pnav:not(.empty):hover .pnav-title { color: var(--accent-hover); }

/* Comments */
.comments-section { padding-block: var(--space-12) clamp(64px, 10vw, 112px); scroll-margin-top: calc(var(--frame) + var(--header-h)); }
.comments-title { margin-bottom: var(--space-6); }

@media (max-width: 960px) {
  .editorial-inner { grid-template-columns: minmax(0, 1fr); }
  .article-sidebar { position: static; order: -1; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); border-block: 1px solid var(--border-subtle); padding-block: var(--space-4); }
  .sidebar-section { border-top: 0; padding: 0; }
  .sidebar-section:nth-last-child(-n+2) { display: none; }
  .sidebar-toc { display: none; }
  .sidebar-author { flex-basis: 100%; }
}
@media (max-width: 640px) {
  .post-nav { grid-template-columns: 1fr; }
  .pnav + .pnav { border-left: 0; border-top: 1px solid var(--border); }
  .pnav.next { text-align: left; }
  .pnav.empty { display: none; }
}
</style>
