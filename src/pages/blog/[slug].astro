---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { u } from '../../utils/url';
import GradBar from '../../components/GradBar.astro';
import Tag from '../../components/Tag.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const { title, intro, description, pubDate, updatedDate, thumbnail, ogImage, tags } = post.data;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/arts/**/*.{jpg,jpeg,png,webp,svg}'
);
const thumbKey = thumbnail ? `/src/assets/${thumbnail}` : null;
const thumbMetadata = thumbKey && allImages[thumbKey]
  ? (await allImages[thumbKey]()).default
  : null;

const dateStr = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Prev/next posts
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: pubDate.toISOString().split('T')[0],
  dateModified: updatedDate ? updatedDate.toISOString().split('T')[0] : pubDate.toISOString().split('T')[0],
});
---
<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  isPost={true}
>
  <!-- Breadcrumb -->
  <div class="crumb-bar">
    <div class="col">
      <div class="crumb-inner">
        <a href={u('/')} class="crumb-link">Home</a>
        <span>/</span>
        <a href={u('/blog')} class="crumb-link">Blog</a>
        <span>/</span>
        <span class="crumb-cur">{title}</span>
      </div>
    </div>
  </div>

  <!-- Post header -->
  <div class="post-header">
    <div class="col">
      <div class="post-top">
        {tags.slice(0, 2).map((tag) => <Tag tag={tag} />)}
        {tags.length > 0 && <span class="dot-sep">·</span>}
        <span class="post-date">{dateStr}</span>
      </div>
      <h1 class="post-title">{title}</h1>
      {intro && <p class="post-lede">{intro}</p>}

      <!-- Hero image -->
      {thumbnail && (
        <div class="hero-img-wrap">
          {thumbMetadata ? (
            <Image
              src={thumbMetadata}
              width={1360}
              height={595}
              alt={title}
              class="hero-img"
              loading="eager"
            />
          ) : (
            <img src={`/assets/${thumbnail}`} width="1360" height="595" alt={title} class="hero-img" />
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Author row -->
  <div class="author-bar">
    <div class="col">
      <div class="author-inner">
        <div class="author-l">
          <div class="author-av" style={`background-image: url('${u('/assets/me.jpg')}')`}></div>
          <div>
            <div class="author-name">Maciek Palmowski</div>
            <div class="author-role">mVDP Growth Manager · Patchstack</div>
          </div>
        </div>
        <div class="share-row">
          <span class="share-label">Share</span>
          <a
            class="share-btn"
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(currentUrl)}`}
            target="_blank"
            rel="noopener"
          >X</a>
          <a
            class="share-btn"
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`}
            target="_blank"
            rel="noopener"
          >LinkedIn</a>
        </div>
      </div>
    </div>
  </div>

  <GradBar />

  <!-- Article content -->
  <div class="article">
    <div class="col prose-post">
      <Content />
    </div>
  </div>

  <!-- Newsletter (right after reading) -->
  <NewsletterBox variant="post" />

  <!-- Post tags -->
  <div class="post-tags-bar">
    <div class="col">
      <span class="tags-label">Tagged:</span>
      {tags.map((tag) => (
        <a href={u(`/tags/${tag}`)}><Tag tag={tag} /></a>
      ))}
    </div>
  </div>

  <!-- Prev / Next nav -->
  {(prevPost || nextPost) && (
    <div class="col">
      <div class="post-nav">
        {prevPost ? (
          <a class="pnav prev" href={u(`/blog/${prevPost.slug}`)}>
            <div class="pnav-dir">← Previous</div>
            {prevPost.data.tags[0] && <div class="pnav-tag">{prevPost.data.tags[0]}</div>}
            <div class="pnav-title">{prevPost.data.title}</div>
          </a>
        ) : <div class="pnav prev empty"></div>}

        {nextPost ? (
          <a class="pnav next" href={u(`/blog/${nextPost.slug}`)}>
            <div class="pnav-dir">Next →</div>
            {nextPost.data.tags[0] && <div class="pnav-tag">{nextPost.data.tags[0]}</div>}
            <div class="pnav-title">{nextPost.data.title}</div>
          </a>
        ) : <div class="pnav next empty"></div>}
      </div>
    </div>
  )}

  <GradBar />

  <!-- Comments -->
  <div class="col comments-section" id="discussion">
    <h2 class="comments-title">Share your thoughts</h2>
    <script
      src="https://giscus.app/client.js"
      data-repo="palmiak/blog-comments"
      data-repo-id="R_kgDOKSw90A"
      data-category="General"
      data-category-id="DIC_kwDOKSw90M4CZQxJ"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="transparent_dark"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </div>

  <script type="application/ld+json" set:html={jsonLd} />

  <script>
    import '../../scripts/main.ts';
  </script>
</Layout>

<style>
.col {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Breadcrumb */
.crumb-bar {
  padding: 18px 0;
  border-bottom: 1px solid var(--bd);
}
.crumb-inner {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--dim);
  flex-wrap: wrap;
}
.crumb-link {
  color: var(--dim);
  text-decoration: none;
  transition: color 0.15s;
}
.crumb-link:hover { color: var(--mid); }
.crumb-cur { color: var(--mid); }

/* Post header */
.post-header {
  padding: 56px 0 0;
  border-bottom: 1px solid var(--bd);
}
.post-top {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}
.dot-sep { color: var(--dim); font-size: 10px; }
.post-date {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  color: var(--mid);
  letter-spacing: 0.05em;
}
.post-title {
  font-family: 'Unbounded', sans-serif;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--hi);
  margin-bottom: 20px;
}
.post-lede {
  font-family: 'Instrument Serif', serif;
  font-size: 22px;
  font-style: italic;
  line-height: 1.55;
  color: var(--mid);
  max-width: 620px;
  margin-bottom: 36px;
}
.hero-img-wrap {
  overflow: hidden;
  border-radius: 6px 6px 0 0;
}
.hero-img {
  width: 100%;
  aspect-ratio: 16 / 7;
  object-fit: cover;
  border-radius: 6px 6px 0 0;
  display: block;
  border: 1px solid var(--bd);
  border-bottom: none;
}

/* Author */
.author-bar {
  padding: 18px 0;
  border-bottom: 1px solid var(--bd);
}
.author-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.author-l {
  display: flex;
  align-items: center;
  gap: 12px;
}
.author-av {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-position: center top;
  background-size: cover;
  border: 1px solid var(--bd2);
  flex-shrink: 0;
}
.author-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--hi);
}
.author-role {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  color: var(--dim);
  letter-spacing: 0.06em;
  margin-top: 2px;
}
.share-row {
  display: flex;
  align-items: center;
  gap: 6px;
}
.share-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  color: var(--dim);
  letter-spacing: 0.1em;
}
.share-btn {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.06em;
  padding: 6px 12px;
  border-radius: 3px;
  border: 1px solid var(--bd2);
  color: var(--mid);
  background: transparent;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s;
  text-decoration: none;
}
.share-btn:hover { color: var(--hi); border-color: rgba(255,255,255,0.25); }

/* Article */
.article {
  padding: 44px 0;
}

/* Post tags */
.post-tags-bar {
  padding: 24px 0;
  border-top: 1px solid var(--bd);
  border-bottom: 1px solid var(--bd);
}
.post-tags-bar .col {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.tags-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--dim);
}
.post-tags-bar a { text-decoration: none; }

/* Prev / Next */
.post-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid var(--bd);
  border-bottom: 1px solid var(--bd);
}
.pnav {
  padding: 24px 20px;
  transition: background 0.12s;
  border-right: 1px solid var(--bd);
  text-decoration: none;
  color: inherit;
  display: block;
}
.pnav.next {
  border-right: none;
  text-align: right;
}
.pnav.empty {
  background: transparent;
}
.pnav:not(.empty):hover { background: var(--bg1); }
.pnav:not(.empty):hover .pnav-title { color: var(--hi); }
.pnav-dir {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  color: var(--dim);
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.pnav.next .pnav-dir { justify-content: flex-end; }
.pnav-tag {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.08em;
  color: var(--dim);
  margin-bottom: 6px;
}
.pnav-title {
  font-family: 'Unbounded', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--mid);
  line-height: 1.4;
  transition: color 0.12s;
}

@media (max-width: 640px) {
  .post-nav {
    grid-template-columns: 1fr;
  }
  .pnav {
    border-right: none;
    border-bottom: 1px solid var(--bd);
    padding: 16px 0;
  }
  .pnav.next {
    text-align: left;
  }
  .pnav.next .pnav-dir {
    justify-content: flex-start;
  }
}

/* Comments */
.comments-section {
  padding: 48px 24px;
}
.comments-title {
  font-family: 'Unbounded', sans-serif;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--hi);
  margin-bottom: 24px;
}
</style>
