---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { u } from '../../utils/url';
import GradBar from '../../components/GradBar.astro';
import Tag from '../../components/Tag.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const { title, intro, description, pubDate, updatedDate, thumbnail, tags } = post.data;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/arts/**/*.{jpg,jpeg,png,webp,svg}'
);
const thumbKey = thumbnail ? `/src/assets/${thumbnail}` : null;
const thumbMetadata = thumbKey && allImages[thumbKey]
  ? (await allImages[thumbKey]()).default
  : null;

const dateStr = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Prev/next posts
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://maciekpalmowski.dev';

const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description ?? intro ?? '',
  url: currentUrl,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
  author: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Maciek Palmowski',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: 'Maciek Palmowski',
    url: siteUrl,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': currentUrl },
  image: new URL(u(`/blog/${post.slug}/og.png`), Astro.site).toString(),
  keywords: tags.join(', '),
});

const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: currentUrl },
  ],
});
---
<Layout
  title={title}
  description={description}
  ogImage={u(`/blog/${post.slug}/og.png`)}
  isPost={true}
>
  <!-- Breadcrumb -->
  <div class="crumb-bar">
    <div class="col-narrow">
      <div class="crumb-inner">
        <a href={u('/')} class="crumb-link">Home</a>
        <span>/</span>
        <a href={u('/blog')} class="crumb-link">Blog</a>
        <span>/</span>
        <span class="crumb-cur">{title}</span>
      </div>
    </div>
  </div>

  <!-- Post header -->
  <div class="post-header">
    <div class="col-narrow">
      <div class="post-top">
        {tags.slice(0, 2).map((tag) => <Tag tag={tag} />)}
        {tags.length > 0 && <span class="dot-sep">·</span>}
        <span class="post-date">{dateStr}</span>
      </div>
      <h1 class="post-title">{title}</h1>
      {intro && <p class="post-lede">{intro}</p>}
    </div>

    <!-- Hero image — wider than text column -->
    {thumbnail && (
      <div class="hero-img-wrap col-wide">
        {thumbMetadata ? (
          <Image
            src={thumbMetadata}
            width={1360}
            height={595}
            alt={title}
            class="hero-img"
            loading="eager"
          />
        ) : (
          <img src={`/assets/${thumbnail}`} width="1360" height="595" alt={title} class="hero-img" />
        )}
      </div>
    )}
  </div>

  <GradBar />

  <!-- Two-column: article + sidebar -->
  <div class="editorial-wrap">
    <div class="editorial-inner">
      <!-- Main article content -->
      <article class="article-col">
        <div class="prose-post">
          <Content />
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="article-sidebar">
        <!-- Author card -->
        <div class="sidebar-section sidebar-author">
          <img class="author-av" src={u('/assets/me.jpg')} alt="Maciek Palmowski" width="48" height="48" />
          <div class="author-name">Maciek Palmowski</div>
          <div class="author-role">mVDP Growth Manager<br/>Patchstack</div>
        </div>

        <!-- Date -->
        <div class="sidebar-section">
          <div class="sidebar-label">Published</div>
          <div class="sidebar-value">{dateStr}</div>
          {updatedDate && (
            <div class="sidebar-value sidebar-updated">
              Updated {updatedDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
            </div>
          )}
        </div>

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="sidebar-section sidebar-tags">
            <div class="sidebar-label">Topics</div>
            <div class="sidebar-tag-list">
              {tags.map((tag) => (
                <a href={u(`/tags/${tag}`)} class="sidebar-tag-link"><Tag tag={tag} /></a>
              ))}
            </div>
          </div>
        )}

        <!-- Share -->
        <div class="sidebar-section sidebar-share">
          <div class="sidebar-label">Share</div>
          <div class="share-row">
            <a
              class="share-btn"
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(currentUrl)}`}
              target="_blank"
              rel="noopener"
            >X / Twitter</a>
            <a
              class="share-btn"
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`}
              target="_blank"
              rel="noopener"
            >LinkedIn</a>
          </div>
        </div>

        <!-- Comments link -->
        <div class="sidebar-section">
          <a href="#discussion" class="sidebar-comments-link">
            <span class="sidebar-label" style="margin-bottom:0">Discussion</span>
            <span class="sidebar-comments-arrow">↓ Leave a comment</span>
          </a>
        </div>
      </aside>
    </div>
  </div>

  <!-- Newsletter (right after reading) -->
  <NewsletterBox variant="post" />

  <!-- Prev / Next nav -->
  {(prevPost || nextPost) && (
    <div class="col-narrow">
      <div class="post-nav">
        {prevPost ? (
          <a class="pnav prev" href={u(`/blog/${prevPost.slug}`)}>
            <div class="pnav-dir">← Previous</div>
            {prevPost.data.tags[0] && <div class="pnav-tag">{prevPost.data.tags[0]}</div>}
            <div class="pnav-title">{prevPost.data.title}</div>
          </a>
        ) : <div class="pnav prev empty"></div>}

        {nextPost ? (
          <a class="pnav next" href={u(`/blog/${nextPost.slug}`)}>
            <div class="pnav-dir">Next →</div>
            {nextPost.data.tags[0] && <div class="pnav-tag">{nextPost.data.tags[0]}</div>}
            <div class="pnav-title">{nextPost.data.title}</div>
          </a>
        ) : <div class="pnav next empty"></div>}
      </div>
    </div>
  )}

  <GradBar />

  <!-- Comments -->
  <div class="col-narrow comments-section" id="discussion">
    <h2 class="comments-title">Share your thoughts</h2>
    <script
      src="https://giscus.app/client.js"
      data-repo="palmiak/blog-comments"
      data-repo-id="R_kgDOKSw90A"
      data-category="General"
      data-category-id="DIC_kwDOKSw90M4CZQxJ"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="transparent_dark"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </div>

  <script type="application/ld+json" is:inline set:html={articleJsonLd} />
  <script type="application/ld+json" is:inline set:html={breadcrumbJsonLd} />

  <script>
    import '../../scripts/main.ts';
  </script>
</Layout>

<style>
/* Columns */
.col-narrow {
  max-width: 760px;
  margin: 0 auto;
  padding: 0 24px;
}

.col-wide {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Breadcrumb */
.crumb-bar {
  padding: 18px 0;
  border-bottom: 1px solid var(--bd);
}
.crumb-inner {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.1em;
  color: var(--dim);
  flex-wrap: wrap;
}
.crumb-link {
  color: var(--dim);
  text-decoration: none;
  transition: color 0.15s;
}
.crumb-link:hover { color: var(--mid); }
.crumb-cur { color: var(--mid); }

/* Post header */
.post-header {
  padding: 56px 0 0;
}
.post-top {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.dot-sep { color: var(--dim); font-size: 10px; }
.post-date {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  color: var(--mid);
  letter-spacing: 0.05em;
}
.post-title {
  font-family: 'Unbounded', sans-serif;
  font-size: clamp(28px, 5vw, 48px);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.1;
  color: var(--hi);
  margin-bottom: 24px;
}
.post-lede {
  font-family: 'Instrument Serif', serif;
  font-size: clamp(20px, 2.5vw, 26px);
  font-style: italic;
  line-height: 1.55;
  color: var(--mid);
  max-width: 640px;
  margin-bottom: 44px;
}

/* Hero image */
.hero-img-wrap {
  margin-top: 0;
  overflow: hidden;
}
.hero-img {
  width: 100%;
  aspect-ratio: 16 / 7;
  object-fit: cover;
  display: block;
  border: 1px solid var(--bd);
  border-radius: 4px;
}

/* Editorial two-column layout */
.editorial-wrap {
  padding: 0 24px;
}
.editorial-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 64px;
  align-items: start;
  padding: 56px 0 64px;
}

/* Article column */
.article-col {
  min-width: 0;
}

/* Wide PostImages break out via transform in global.css — reset to full column width */
.article-col :global(.image.wide) {
  position: static;
  left: 0;
  transform: none;
  width: 100%;
}

/* Sidebar */
.article-sidebar {
  position: sticky;
  /* 54px sticky header + 24px breathing room */
  top: calc(54px + 24px);
  display: flex;
  flex-direction: column;
  gap: 0;
}

.sidebar-section {
  padding: 20px 0;
  border-bottom: 1px solid var(--bd);
}
.sidebar-section:first-child {
  border-top: 1px solid var(--bd);
}

.sidebar-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.14em;
  color: var(--dim);
  text-transform: uppercase;
  margin-bottom: 10px;
}
.sidebar-value {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  color: var(--mid);
  letter-spacing: 0.04em;
}
.sidebar-updated {
  margin-top: 4px;
  color: var(--dim);
  font-size: 10px;
}

/* Sidebar author */
.sidebar-author {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.author-av {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  object-position: center top;
  border: 1px solid var(--bd2);
  margin-bottom: 4px;
}
.author-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--hi);
  line-height: 1.3;
}
.author-role {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  color: var(--dim);
  letter-spacing: 0.04em;
  line-height: 1.6;
}

/* Sidebar tags */
.sidebar-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.sidebar-tag-link { text-decoration: none; }

/* Share */
.share-row {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.share-btn {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.06em;
  padding: 7px 12px;
  border-radius: 3px;
  border: 1px solid var(--bd2);
  color: var(--mid);
  background: transparent;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s;
  text-decoration: none;
  text-align: center;
}
.share-btn:hover { color: var(--hi); border-color: rgba(255,255,255,0.25); }

/* Prev / Next */
.post-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid var(--bd);
  border-bottom: 1px solid var(--bd);
}
.pnav {
  padding: 28px 20px;
  transition: background 0.12s;
  border-right: 1px solid var(--bd);
  text-decoration: none;
  color: inherit;
  display: block;
}
.pnav.next {
  border-right: none;
  text-align: right;
}
.pnav.empty {
  background: transparent;
}
.pnav:not(.empty):hover { background: var(--bg1); }
.pnav:not(.empty):hover .pnav-title { color: var(--hi); }
.pnav-dir {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  color: var(--dim);
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.pnav.next .pnav-dir { justify-content: flex-end; }
.pnav-tag {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.08em;
  color: var(--dim);
  margin-bottom: 6px;
}
.pnav-title {
  font-family: 'Unbounded', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--mid);
  line-height: 1.4;
  transition: color 0.12s;
}

/* Comments link in sidebar */
.sidebar-comments-link {
  display: flex;
  flex-direction: column;
  gap: 6px;
  text-decoration: none;
}
.sidebar-comments-link:hover .sidebar-comments-arrow {
  color: var(--hi);
}
.sidebar-comments-arrow {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px;
  color: var(--mid);
  letter-spacing: 0.04em;
  transition: color 0.15s;
}

/* Comments */
.comments-section {
  padding: 48px 24px;
  scroll-margin-top: calc(54px + 16px);
}
.comments-title {
  font-family: 'Unbounded', sans-serif;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--hi);
  margin-bottom: 24px;
}

/* Responsive: collapse to single column below 900px */
@media (max-width: 900px) {
  .editorial-inner {
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 40px 0 48px;
  }

  .article-sidebar {
    position: static;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid var(--bd);
    border-bottom: 1px solid var(--bd);
  }

  .sidebar-section {
    flex: 1 1 200px;
    border-bottom: none;
    border-right: 1px solid var(--bd);
    padding: 16px 20px;
  }
  .sidebar-section:first-child {
    border-top: none;
  }
  .sidebar-section:last-child {
    border-right: none;
  }

  .sidebar-author {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    flex: 100%;
    border-right: none !important;
    border-bottom: 1px solid var(--bd) !important;
  }
  .author-av {
    width: 36px;
    height: 36px;
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .share-row {
    flex-direction: row;
  }

  .post-title {
    font-size: clamp(26px, 6vw, 40px);
  }
}

@media (max-width: 640px) {
  .post-nav {
    grid-template-columns: 1fr;
  }
  .pnav {
    border-right: none;
    border-bottom: 1px solid var(--bd);
    padding: 16px 0;
  }
  .pnav.next {
    text-align: left;
  }
  .pnav.next .pnav-dir {
    justify-content: flex-start;
  }

  .article-sidebar {
    flex-direction: column;
  }
  .sidebar-section {
    flex: none;
    border-right: none;
    border-bottom: 1px solid var(--bd);
    padding: 14px 0;
  }
  .sidebar-section:first-child {
    border-top: 1px solid var(--bd);
  }
  .sidebar-author {
    border-bottom: 1px solid var(--bd) !important;
  }
}
</style>
