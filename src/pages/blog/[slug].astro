---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const { title, intro, description, pubDate, updatedDate, thumbnail, ogImage, tags } = post.data;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/arts/**/*.{jpg,jpeg,png,webp,svg}'
);
const thumbKey = thumbnail ? `/src/assets/${thumbnail}` : null;
const thumbMetadata = thumbKey && allImages[thumbKey]
  ? (await allImages[thumbKey]()).default
  : null;

const dateStr = pubDate.toISOString().split('T')[0].replace(/-/g, ' - ');
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  datePublished: pubDate.toISOString().split('T')[0],
  dateModified: updatedDate ? updatedDate.toISOString().split('T')[0] : pubDate.toISOString().split('T')[0],
});
---
<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  isPost={true}
>
  <article class="container mx-auto max-w-[1400px] grid grid-cols-1 gap-8 justify-items-center">
    <div class="max-w-3xl mx-auto grid grid-cols-1 gap-7 px-5">
      {tags.length > 0 && (
        <div class="blog-item-tags justify-start items-center gap-5 inline-flex">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`}>
              <div class="text-white text-xs font-normal font-palmiak-font-title tracking-wide">{tag}</div>
            </a>
          ))}
        </div>
      )}

      <h1 class="text-2xl md:text-5xl font-bold font-palmiak-font-title m-0 leading-tight text-white">{title}</h1>
      <hr class="gradient-line" />

      <div>
        <span class="text-white text-sm font-medium font-palmiak-font leading-normal tracking-widest">{dateStr}</span>
      </div>
    </div>

    {thumbnail && (
      <div class="blog-item gradient-border p-7 bg-palmiak_bg border border-indigo-950 border-opacity-50 max-w-[95vw]">
        <picture class="rounded-md block mb-0 palmiak-image">
          {thumbMetadata ? (
            <Image
              src={thumbMetadata}
              width={1400}
              height={700}
              alt={title}
              class="rounded-md"
              loading="eager"
            />
          ) : (
            <img src={`/assets/${thumbnail}`} width="1400" height="700" alt={title} class="rounded-md" />
          )}
        </picture>
      </div>
    )}

    <div class="px-5 prose-post max-w-3xl w-full mx-auto">
      {intro && (
        <p class="text-2xl text-white font-bold">{intro}</p>
      )}
      <Content />
    </div>

    <NewsletterBox />

    <div class="max-w-3xl w-full mx-auto grid grid-cols-1 gap-7 px-5" id="discussion">
      <h2 class="text-xl md:text-2xl font-bold font-palmiak-font-title mt-10 text-white">Share your thoughts</h2>
      <hr class="gradient-line" />
      <script
        src="https://giscus.app/client.js"
        data-repo="palmiak/blog-comments"
        data-repo-id="R_kgDOKSw90A"
        data-category="General"
        data-category-id="DIC_kwDOKSw90M4CZQxJ"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="transparent_dark"
        data-lang="en"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      ></script>
    </div>
  </article>

  <div class="mt-20 text-center flex items-center justify-center px-5">
    <div class="mx-2">
      <a href="/blog" class="inline-flex items-center border border-zinc-700 text-sm px-4 py-2 rounded-full transition-colors hover:text-emerald-50 hover:border-zinc-600">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        All Articles
      </a>
    </div>

    <div class="mx-2 relative">
      <button
        id="share-btn"
        class="inline-flex items-center border border-zinc-700 text-sm px-4 py-2 rounded-full transition-colors cursor-pointer hover:text-emerald-50 hover:border-zinc-600"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        Share
      </button>

      <div id="share-menu" class="absolute bottom-14 -left-[40px] shadow-lg bg-zinc-700 p-1 rounded-lg w-[180px] text-sm hidden">
        <ul class="text-left">
          <li>
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(currentUrl)}`}
              rel="noopener"
              target="_blank"
              class="px-3 py-1 block hover:bg-zinc-600 transition-colors rounded-lg hover:text-white"
            >
              Share on Twitter
            </a>
          </li>
          <li>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
              rel="noopener"
              target="_blank"
              class="px-3 py-1 block hover:bg-zinc-600 transition-colors rounded-md hover:text-white"
            >
              Share on Facebook
            </a>
          </li>
          <li>
            <a
              href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(currentUrl)}`}
              rel="noopener"
              class="px-3 py-1 block hover:bg-zinc-600 transition-colors rounded-md hover:text-white"
            >
              Share via Email
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={jsonLd} />

  <script>
    import '../../scripts/main.ts';

    const shareBtn = document.getElementById('share-btn');
    const shareMenu = document.getElementById('share-menu');

    shareBtn?.addEventListener('click', () => {
      const isOpen = !shareMenu?.classList.contains('hidden');
      shareMenu?.classList.toggle('hidden', isOpen);
      shareBtn.setAttribute('aria-expanded', String(!isOpen));
    });

    document.addEventListener('click', (e) => {
      if (shareBtn && shareMenu && !shareBtn.contains(e.target as Node) && !shareMenu.contains(e.target as Node)) {
        shareMenu.classList.add('hidden');
        shareBtn.setAttribute('aria-expanded', 'false');
      }
    });
  </script>
</Layout>
