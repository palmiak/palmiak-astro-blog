---
import { getCollection } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { u } from '../../../utils/url';
import { SITE, abs } from '../../../utils/site';
import PostRow from '../../../components/PostRow.astro';
import SectionHeader from '../../../components/SectionHeader.astro';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

  return tags.flatMap((tag) => {
    const tagPosts = posts
      .filter((p) => p.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return paginate(tagPosts, { params: { tag }, pageSize: 10 });
  });
};

type Props = {
  page: Page<CollectionEntry<'posts'>>;
};

const { tag } = Astro.params;
const { page } = Astro.props;

const collectionJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `#${tag} — Maciek Palmowski`,
  url: abs(Astro.url.pathname),
  author: {
    '@type': 'Person',
    '@id': `${SITE}/#person`,
    name: 'Maciek Palmowski',
  },
});
---
<Layout title={`#${tag}`} description={`All posts tagged with ${tag}`} ogImage={u(`/tags/${tag}/og.png`)}>
  <header class="wrap page-head">
    <SectionHeader page title={tag ?? ''} lede={`Posts tagged ${tag}.`} />
    <a class="btn btn-ghost back" href={u('/blog')}>All posts</a>
  </header>

  <div class="wrap posts-list">
    {page.data.map((post) => (
      <PostRow
        title={post.data.title}
        slug={post.slug}
        tags={post.data.tags}
        excerpt={post.data.excerpt ?? post.data.description}
        pubDate={post.data.pubDate}
      />
    ))}
  </div>

  {page.lastPage > 1 && (
    <nav class="wrap pagination" aria-label="Pagination">
      {page.url.prev ? (
        <a href={page.url.prev} class="btn btn-secondary">Previous</a>
      ) : <span class="btn btn-secondary" aria-disabled="true">Previous</span>}
      <span class="pag-count">{page.currentPage} / {page.lastPage}</span>
      {page.url.next ? (
        <a href={page.url.next} class="btn btn-secondary">Next</a>
      ) : <span class="btn btn-secondary" aria-disabled="true">Next</span>}
    </nav>
  )}

  <script type="application/ld+json" is:inline set:html={collectionJsonLd} />
</Layout>

<style>
.back { margin: var(--space-6) 0 0 -12px; }
.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  padding-block: var(--space-12);
}
.pag-count { font-family: var(--font-mono); font-size: 12.5px; color: var(--ink-subtle); }
</style>
